---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";

/**
 * Learn index — dynamic.
 *
 * Articles are pulled from the `learn` content collection. Any new .mdx file
 * dropped into src/content/learn/ will appear automatically (unless draft:true).
 *
 * Section split:
 *   - "Foundations" = the curated evergreen explainers listed in FOUNDATION_SLUGS.
 *   - "Editor's Take" = everything else, sorted newest-first by publishedAt.
 *
 * Per-article eyebrow label:
 *   - Use EYEBROW_OVERRIDES[slug] if present (matches the labels used on the
 *     live site before this refactor).
 *   - Otherwise, title-case the article's first tag.
 */

// Foundations are the 5 stable beginner explainers. Order here = display order.
const FOUNDATION_SLUGS = [
  "types-of-annuities",
  "cap-rates",
  "fia-vs-myga",
  "best-fia-index-strategies",
  "how-to-read-fia-illustration",
];

// Curated eyebrow labels (match what was on the live site).
const EYEBROW_OVERRIDES: Record<string, string> = {
  "types-of-annuities": "Foundations",
  "cap-rates": "FIA Mechanics",
  "fia-vs-myga": "Product Comparison",
  "best-fia-index-strategies": "Index Analysis",
  "how-to-read-fia-illustration": "Due Diligence",
  "new-annuity-products-2026": "Market Analysis",
  "corebridge-equitable-merger": "Industry Analysis",
  "carrier-debt-risk": "Risk & Due Diligence",
  "interest-recapture": "Risk & Due Diligence",
  "market-value-adjustment": "Contract Terms",
  "share-classes": "Compensation",
  "fidelity-fpra": "Product Comparison",
  "volatility-indexes": "Index Analysis",
  "renewal-cap-rates": "Rates & Pricing",
  "best-fixed-indexed-annuities": "Rankings",
  "best-variable-annuities": "Rankings",
  "fia-vs-rila": "Product Comparison",
  "variable-annuity-fees": "Fee Analysis",
  "best-annuity-retirement-income": "Income Planning",
  "ubs-widow-variable-annuity-arbitration": "Case Study",
};

function titleCase(s: string): string {
  return s
    .split(/\s+/)
    .map((w) => (w.length === 0 ? w : w[0].toUpperCase() + w.slice(1)))
    .join(" ");
}

function eyebrowFor(slug: string, tags: string[] | undefined): string {
  if (EYEBROW_OVERRIDES[slug]) return EYEBROW_OVERRIDES[slug];
  if (tags && tags.length > 0) return titleCase(tags[0]);
  return "Article";
}

type CardData = {
  slug: string;
  eyebrow: string;
  title: string;
  description: string;
};

// Pull every non-draft Learn article.
const allEntries = await getCollection("learn", (entry) => entry.data.draft !== true);

// Index by slug for foundation lookup. Prefer the frontmatter slug field; fall
// back to the file slug Astro derives from the filename.
const bySlug = new Map<string, (typeof allEntries)[number]>();
for (const entry of allEntries) {
  const s = (entry.data as any).slug || entry.slug;
  bySlug.set(s, entry);
}

// Build Foundations in the curated order. Skip any that aren't on disk.
const foundations: CardData[] = FOUNDATION_SLUGS.map((slug) => {
  const entry = bySlug.get(slug);
  if (!entry) return null;
  const data = entry.data as any;
  return {
    slug,
    eyebrow: eyebrowFor(slug, data.tags),
    title: data.title as string,
    description: data.description as string,
  } as CardData;
}).filter((x): x is CardData => x !== null);

// Editor's Take = everything not in Foundations, newest first.
const foundationSet = new Set(FOUNDATION_SLUGS);
const editorsTake: CardData[] = allEntries
  .filter((entry) => {
    const s = (entry.data as any).slug || entry.slug;
    return !foundationSet.has(s);
  })
  .sort((a, b) => {
    const da = new Date((a.data as any).publishedAt).getTime();
    const db = new Date((b.data as any).publishedAt).getTime();
    return db - da;
  })
  .map((entry) => {
    const data = entry.data as any;
    const slug = data.slug || entry.slug;
    return {
      slug,
      eyebrow: eyebrowFor(slug, data.tags),
      title: data.title as string,
      description: data.description as string,
    };
  });
---

<BaseLayout
  title="Learn About Annuities | RankMyAnnuity"
  description="Plain-English guides from a licensed professional who has reviewed thousands of annuity contracts. No sales agenda — just the mechanics you need to evaluate an offer."
>
  <article style="max-width:1024px;margin:0 auto;padding:48px 24px 64px 24px;font-family:'DM Sans', ui-sans-serif, system-ui, sans-serif;color:rgb(1,8,22);">

    <!-- Hero -->
    <p style="margin:0 0 8px 0;font-size:12px;font-weight:600;text-transform:uppercase;letter-spacing:0.08em;color:rgb(249,112,21);">Education</p>

    <h1 style="font-family:'DM Serif Display', Georgia, serif;font-weight:400;font-size:56px;line-height:1.1;letter-spacing:-0.025em;margin:0 0 20px 0;color:rgb(1,8,22);max-width:820px;">
      Learn About Annuities
    </h1>

    <p style="font-size:19px;line-height:1.6;color:rgb(51,65,85);margin:0 0 56px 0;max-width:760px;">
      Plain-English guides from a licensed professional who has reviewed thousands of annuity contracts. No sales agenda — just the mechanics you need to evaluate an offer.
    </p>

    <!-- FOUNDATIONS section -->
    <section style="margin:0 0 64px 0;">
      <header style="display:flex;align-items:baseline;justify-content:space-between;gap:16px;margin:0 0 24px 0;padding:0 0 12px 0;border-bottom:1px solid rgb(226,232,240);">
        <div>
          <h2 style="font-family:'DM Serif Display', Georgia, serif;font-weight:400;font-size:32px;line-height:1.2;letter-spacing:-0.02em;margin:0 0 4px 0;color:rgb(1,8,22);">
            Foundations
          </h2>
          <p style="margin:0;font-size:14px;color:rgb(100,116,139);">Start here if you're evaluating your first annuity offer.</p>
        </div>
      </header>

      <div class="rma-card-grid" style="display:grid;grid-template-columns:repeat(2,1fr);gap:20px;">
        {foundations.map((a) => (
          <a
            href={`/learn/${a.slug}`}
            class="rma-card"
            style="display:flex;flex-direction:column;padding:24px;background:rgb(255,255,255);border:1px solid rgb(226,232,240);border-radius:10px;text-decoration:none;transition:border-color .15s,transform .15s,box-shadow .15s;"
          >
            <p style="margin:0 0 10px 0;font-size:11px;font-weight:600;text-transform:uppercase;letter-spacing:0.08em;color:rgb(249,112,21);">
              {a.eyebrow}
            </p>
            <h3 style="font-family:'DM Serif Display', Georgia, serif;font-weight:400;font-size:22px;line-height:1.3;margin:0 0 10px 0;color:rgb(1,8,22);">
              {a.title}
            </h3>
            <p style="margin:0 0 16px 0;font-size:15px;line-height:1.6;color:rgb(51,65,85);flex:1;">
              {a.description}
            </p>
            <span style="font-size:13px;font-weight:500;color:rgb(15,23,42);">Read article →</span>
          </a>
        ))}

        <!-- Glossary callout in same grid -->
        <a
          href="/glossary"
          class="rma-card rma-card-feature"
          style="display:flex;flex-direction:column;padding:24px;background:rgb(15,23,42);border:1px solid rgb(15,23,42);border-radius:10px;text-decoration:none;color:rgb(248,250,252);transition:transform .15s,box-shadow .15s;"
        >
          <p style="margin:0 0 10px 0;font-size:11px;font-weight:600;text-transform:uppercase;letter-spacing:0.08em;color:rgb(249,112,21);">
            Reference
          </p>
          <h3 style="font-family:'DM Serif Display', Georgia, serif;font-weight:400;font-size:22px;line-height:1.3;margin:0 0 10px 0;color:rgb(248,250,252);">
            Annuity Glossary
          </h3>
          <p style="margin:0 0 16px 0;font-size:15px;line-height:1.6;color:rgb(203,213,225);flex:1;">
            Plain-English definitions for 30 annuity and FIA contract terms — from cap rate and GLWB to backtested index data and volatility-controlled indexes.
          </p>
          <span style="font-size:13px;font-weight:500;color:rgb(248,250,252);">View glossary →</span>
        </a>
      </div>
    </section>

    <!-- EDITOR'S TAKE section -->
    <section style="margin:0 0 64px 0;">
      <header style="display:flex;align-items:baseline;justify-content:space-between;gap:16px;margin:0 0 24px 0;padding:0 0 12px 0;border-bottom:1px solid rgb(226,232,240);">
        <div>
          <h2 style="font-family:'DM Serif Display', Georgia, serif;font-weight:400;font-size:32px;line-height:1.2;letter-spacing:-0.02em;margin:0 0 4px 0;color:rgb(1,8,22);">
            Editor's Take
          </h2>
          <p style="margin:0;font-size:14px;color:rgb(100,116,139);">
            In-depth editorial analysis of the annuity market.
          </p>
        </div>
      </header>

      <div class="rma-card-grid" style="display:grid;grid-template-columns:repeat(2,1fr);gap:20px;">
        {editorsTake.map((a) => (
          <a
            href={`/learn/${a.slug}`}
            class="rma-card"
            style="display:flex;flex-direction:column;padding:24px;background:rgb(255,255,255);border:1px solid rgb(226,232,240);border-radius:10px;text-decoration:none;transition:border-color .15s,transform .15s,box-shadow .15s;"
          >
            <p style="margin:0 0 10px 0;font-size:11px;font-weight:600;text-transform:uppercase;letter-spacing:0.08em;color:rgb(249,112,21);">
              {a.eyebrow}
            </p>
            <h3 style="font-family:'DM Serif Display', Georgia, serif;font-weight:400;font-size:22px;line-height:1.3;margin:0 0 10px 0;color:rgb(1,8,22);">
              {a.title}
            </h3>
            <p style="margin:0 0 16px 0;font-size:15px;line-height:1.6;color:rgb(51,65,85);flex:1;">
              {a.description}
            </p>
            <span style="font-size:13px;font-weight:500;color:rgb(15,23,42);">Read article →</span>
          </a>
        ))}
      </div>
    </section>

    <!-- CTA: Ready to put it to work? -->
    <section style="margin:32px 0 0 0;padding:40px 32px;background:rgb(248,250,252);border:1px solid rgb(226,232,240);border-radius:12px;text-align:center;">
      <h2 style="font-family:'DM Serif Display', Georgia, serif;font-weight:400;font-size:32px;line-height:1.2;letter-spacing:-0.02em;margin:0 0 8px 0;color:rgb(1,8,22);">
        Ready to put it to work?
      </h2>
      <p style="margin:0 0 24px 0;font-size:15px;color:rgb(100,116,139);">
        Both calculators are free and require no account.
      </p>
      <div style="display:inline-flex;flex-wrap:wrap;gap:12px;justify-content:center;">
        <a href="/calculator" style="padding:12px 24px;border-radius:8px;font-size:15px;font-weight:500;text-decoration:none;background:rgb(15,23,42);color:rgb(248,250,252);transition:background-color .15s;">
          Grade My Annuity
        </a>
        <a href="/calculator" style="padding:12px 24px;border-radius:8px;font-size:15px;font-weight:500;text-decoration:none;background:rgb(255,255,255);color:rgb(15,23,42);border:1px solid rgb(226,232,240);transition:border-color .15s;">
          Index Calculator
        </a>
      </div>
    </section>

  </article>
</BaseLayout>

<style>
  /* Card hover */
  .rma-card:hover {
    border-color: rgb(15, 23, 42) !important;
    transform: translateY(-2px);
    box-shadow: 0 8px 16px -8px rgba(15, 23, 42, 0.15);
  }
  .rma-card-feature:hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 16px -8px rgba(15, 23, 42, 0.35);
  }
  /* CTA buttons */
  article a[href="/calculator"]:first-of-type:hover {
    background: rgb(30, 41, 59) !important;
  }
  article a[href="/calculator"]:last-of-type:hover {
    border-color: rgb(15, 23, 42) !important;
  }
  /* Mobile: single column */
  @media (max-width: 720px) {
    .rma-card-grid {
      grid-template-columns: 1fr !important;
    }
  }
</style>
