---
// /rates — server-rendered MYGA rate table plus the 4-card benchmark panel.
//
// All data is sourced from Phase 4 pipeline outputs:
//   src/generated/rates/myga.json           — the MYGA rate rows
//   src/generated/benchmarks.json           — the 4-card comparison panel
// These files are regenerated by `npm run publish-data`; never hand-edited.
//
// Per Phase 4 brief: this page must render *something* even when the
// curated rate corpus is empty (Athene pilot). We display an empty-state
// notice with the provenance that produced it, so the gap is obvious and
// attributable — not hidden.

import ToolLayout from '@layouts/ToolLayout.astro';
import ratesPayload from '../generated/rates/myga.json';
import benchmarksPayload from '../generated/benchmarks.json';
import NotLiveChip from '@components/NotLiveChip.astro';
import {
  BENCHMARK_CHIP_LABEL,
  BENCHMARK_VALUE_TESTID,
  benchmarkValueString,
  isBenchmarkNotLive,
  staleMygaRateChipLabel,
  type BenchmarkNotLiveCause,
  type BenchmarkStatus,
} from '@lib/ui/liveness';

type Rate = {
  carrier_slug: string;
  product_slug: string;
  // [Phase 5.0d] Product-variant fidelity — real product name behind the
  // generic product_slug MDX (e.g. "Secure Term MVA II").
  product_variant: string;
  product_variant_slug: string;
  term_years: number;
  rate: number;
  premium_band_min: number;
  premium_band_max: number | null;
  effective_date: string;
  // [Phase 5.0d] observed_at drives the stale-chip age calculation when
  // the top MYGA benchmark is degraded. Optional on the row type for
  // back-compat with pre-0.5.0 generated JSON.
  observed_at?: string;
  source_name: string;
  source_url: string | null;
};

type BenchmarkSnapshot = {
  label: string;
  rate: number;
  source: string;
  source_url: string;
  as_of: string;
  adapter_id: string;
  // [Phase 5] Optional in the type so older generated JSON without
  // `status` still type-checks; the render path below falls back to
  // "live" when the field is missing.
  status?: BenchmarkStatus;
  // [Phase 5.0d] Optional for the same back-compat reason — pre-5.0d
  // JSON doesn't carry this field.
  not_live_cause?: BenchmarkNotLiveCause;
};

const rates = (ratesPayload.rates ?? []) as Rate[];
const panel = benchmarksPayload.panel as Record<string, BenchmarkSnapshot>;
const panelKeys: Array<keyof typeof panel> = [
  'top_myga_5yr',
  'treasury_10yr',
  'cd_5yr_national_avg',
  'sp500_historical',
];

// [Phase 5] Keep `pct` for live-rate formatting; any not-live benchmark
// goes through benchmarkValueString (which always returns em-dash for
// non-live statuses — the em-dash is the UI invariant, never "0.00%").
const pct = (r: number) => `${(r * 100).toFixed(2)}%`;

// [Phase 5.0d] Compute stale-age for the top_myga_5yr chip when the
// benchmark is degraded with cause "stale_myga_rate". We use the top
// MYGA snapshot's `as_of` (which normalize sets to the rate's
// effective_date) as a proxy if no observed_at is reachable; but the
// richer path is to look up the selected rate in the rates table by
// the product slug linked in the benchmark source string. For 5.0d we
// keep it simple: surface the snapshot's as_of relative to today.
const today = new Date();
function ageDaysFromIso(iso: string): number {
  const d = new Date(`${iso}T00:00:00.000Z`);
  if (Number.isNaN(d.getTime())) return 0;
  return (today.getTime() - d.getTime()) / (1000 * 60 * 60 * 24);
}
const fmtBand = (min: number, max: number | null) => {
  const minStr = new Intl.NumberFormat('en-US', { style: 'currency', currency: 'USD', maximumFractionDigits: 0 }).format(min);
  if (max === null) return `${minStr}+`;
  const maxStr = new Intl.NumberFormat('en-US', { style: 'currency', currency: 'USD', maximumFractionDigits: 0 }).format(max);
  return `${minStr} – ${maxStr}`;
};
---
<ToolLayout
  title="Current Annuity Rates"
  description="MYGA rates and comparison benchmarks rendered at build time from the Phase 4 data pipeline."
  intro="Rows are server-rendered from curated YAML sources and API adapters (FRED, TreasuryDirect, FDIC). Every rate links to its source; every benchmark shows its as-of date."
  canonicalPath="/rates"
  noscriptText="This page is fully server-rendered. No JavaScript is required to see the table."
>
  <div slot="tool" class="space-y-8">
    <!-- Benchmark panel -->
    <section aria-label="Benchmark comparison panel">
      <h2 class="text-lg font-semibold mb-3">Comparison benchmarks</h2>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-3">
        {panelKeys.map((key) => {
          const s = panel[key];
          // [Phase 5] Default missing status to "live" for backwards
          // compat with pre-0.5.0 generated benchmarks.json. Once the
          // pipeline is re-run, every snapshot carries an explicit status.
          const status: BenchmarkStatus = s.status ?? 'live';
          const notLiveCause: BenchmarkNotLiveCause = s.not_live_cause ?? null;
          const notLive = isBenchmarkNotLive(status);
          const valueString = benchmarkValueString(status, s.rate);
          // [Phase 5.0d] Pick the right chip. "stale_myga_rate" uses a
          // distinct label that surfaces the observation age; other
          // degraded/pilot_empty causes fall back to the generic labels.
          const chipLabel =
            status === 'degraded' && notLiveCause === 'stale_myga_rate'
              ? staleMygaRateChipLabel(ageDaysFromIso(s.as_of))
              : status !== 'live'
                ? BENCHMARK_CHIP_LABEL[status]
                : null;
          return (
            <div class="rounded border border-[var(--rule)] p-4">
              <div class="text-xs uppercase tracking-wide text-[var(--muted)]">{s.label}</div>
              <div class="text-2xl font-semibold mt-1 flex flex-wrap items-center gap-2">
                <span data-testid={BENCHMARK_VALUE_TESTID}>{valueString}</span>
                {notLive && chipLabel && (
                  <NotLiveChip label={chipLabel} />
                )}
              </div>
              <div class="text-xs text-[var(--muted)] mt-2">
                as of <time datetime={s.as_of}>{s.as_of}</time>
              </div>
              <div class="text-xs mt-1">
                <a href={s.source_url} class="underline text-[var(--muted)]" rel="noopener">
                  {s.source}
                </a>
              </div>
            </div>
          );
        })}
      </div>
    </section>

    <!-- MYGA rate table -->
    <section aria-label="MYGA rate table">
      <h2 class="text-lg font-semibold mb-3">MYGA rates</h2>
      {rates.length === 0 ? (
        <div class="rounded border border-[var(--rule)] p-6 text-sm text-[var(--muted)]">
          <strong class="block text-[var(--fg)] mb-1">No MYGA rates in the current corpus.</strong>
          The curated rate source (<code>data-pipeline/sources/rates.myga.yml</code>) has no entries in this pilot.
          The only Athene review presently in scope is the Performance Elite FIA, which is not a MYGA product.
          Rates appear here automatically once a MYGA product review is added to the corpus and its rate is logged.
        </div>
      ) : (
        <div class="overflow-x-auto">
          <table class="w-full text-sm">
            <thead>
              <tr class="border-b border-[var(--rule)] text-left text-xs uppercase tracking-wide text-[var(--muted)]">
                <th class="py-2 pr-4">Carrier</th>
                <th class="py-2 pr-4">Product</th>
                <th class="py-2 pr-4 text-right">Term</th>
                <th class="py-2 pr-4 text-right">Rate</th>
                <th class="py-2 pr-4">Premium band</th>
                <th class="py-2 pr-4">Effective</th>
                <th class="py-2">Source</th>
              </tr>
            </thead>
            <tbody>
              {rates.map((r) => (
                <tr class="border-b border-[var(--rule)]">
                  <td class="py-2 pr-4 capitalize">{r.carrier_slug}</td>
                  <td class="py-2 pr-4">
                    <a href={`/reviews/${r.product_slug}`} class="underline">{r.product_variant ?? r.product_slug}</a>
                  </td>
                  <td class="py-2 pr-4 text-right">{r.term_years}y</td>
                  <td class="py-2 pr-4 text-right font-semibold">{pct(r.rate)}</td>
                  <td class="py-2 pr-4">{fmtBand(r.premium_band_min, r.premium_band_max)}</td>
                  <td class="py-2 pr-4"><time datetime={r.effective_date}>{r.effective_date}</time></td>
                  <td class="py-2">
                    {r.source_url ? (
                      <a href={r.source_url} class="underline text-[var(--muted)]" rel="noopener">{r.source_name}</a>
                    ) : (
                      <span class="text-[var(--muted)]">{r.source_name}</span>
                    )}
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      )}
    </section>

    <p class="text-xs text-[var(--muted)]">
      Table and panel are regenerated by the data pipeline. Provenance is recorded in the build manifest. Last pipeline run: <code>{ratesPayload.generated_at ?? 'n/a'}</code>.
    </p>
  </div>
</ToolLayout>
