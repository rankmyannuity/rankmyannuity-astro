---
import BaseLayout from "../layouts/BaseLayout.astro";

const title = "Today's Annuity Rates — MYGA, FIA & VA Rates | RankMyAnnuity";
const description =
  "Current annuity rates for MYGAs, fixed indexed annuities, and variable annuities. Updated regularly with source citations and effective dates.";

const SERIF = "'DM Serif Display', Georgia, serif";

const lastUpdated = "April 13, 2026";

// FIA Cap Rates table
const fiaRows = [
  { term: "3-Year", rate: "8.75%", carrier: "United of Omaha (Mutual of Omaha)", amBest: "A+", note: "—" },
  { term: "5-Year", rate: "10.50%", carrier: "Axonic Insurance Services", amBest: "A-", note: "—" },
  { term: "6-Year", rate: "7.85%", carrier: "Americo Financial Life", amBest: "A", note: "—" },
  { term: "7-Year", rate: "10.50%", carrier: "Axonic Insurance Services", amBest: "A-", note: "—" },
  { term: "8-Year", rate: "9.30%", carrier: "Midland National Life", amBest: "A+", note: "↑ 0.75% this week" },
  { term: "9-Year", rate: "10.25%", carrier: "S.USA Life Insurance", amBest: "A-", note: "—" },
  { term: "10-Year", rate: "10.50%", carrier: "American Life & Security Corp", amBest: "B++", note: "Top rate" },
  { term: "12-Year", rate: "7.75%", carrier: "North American Co. for Life & Health", amBest: "A+", note: "—" },
  { term: "15-Year", rate: "7.00%", carrier: "Athene Annuity and Life", amBest: "A+", note: "—" },
];

// MYGA Rates table
const mygaRows = [
  { term: "1-Year", rate: "6.00%", carrier: "Global Atlantic", product: "ForeCare Fixed Annuity (LTC)", amBest: "A" },
  { term: "2-Year", rate: "5.50%", carrier: "Axonic Insurance Services", product: "Skyline MYGA", amBest: "A-" },
  { term: "3-Year", rate: "6.00%", carrier: "Mountain Life Insurance", product: "Alpine Horizon", amBest: "B+" },
  { term: "5-Year", rate: "6.45%", carrier: "Atlantic Coast Life", product: "Safe Harbor Bonus Guarantee", amBest: "B+" },
  { term: "7-Year", rate: "6.90%", carrier: "Atlantic Coast Life", product: "Safe Harbor Bonus Guarantee", amBest: "B+" },
  { term: "10-Year", rate: "7.65%", carrier: "Atlantic Coast Life", product: "Safe Harbor Bonus Guarantee", amBest: "B+" },
];

function badgeColor(amBest: string) {
  // Map AM Best → bg color
  if (amBest.startsWith("A++") || amBest === "A+") return "rgb(5,150,105)";
  if (amBest === "A" || amBest === "A-") return "rgb(16,185,129)";
  if (amBest.startsWith("B")) return "rgb(245,158,11)";
  return "rgb(100,116,139)";
}
---

<BaseLayout title={title} description={description}>
  <link
    slot="head"
    rel="preconnect"
    href="https://fonts.googleapis.com"
  />
  <link
    slot="head"
    rel="preconnect"
    href="https://fonts.gstatic.com"
    crossorigin
  />
  <link
    slot="head"
    rel="stylesheet"
    href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=DM+Serif+Display:ital@0;1&display=swap"
  />

  <main
    style="max-width:1024px;margin:0 auto;padding:48px 24px;color:rgb(1,8,22);font-family:'DM Sans',ui-sans-serif,system-ui,sans-serif;"
  >
    {/* Eyebrow */}
    <div
      style="margin-bottom:8px;font-size:12px;font-weight:500;color:rgb(249,112,21);text-transform:uppercase;letter-spacing:0.1em;"
    >
      Market Data
    </div>
    <h1
      style={`font-family:${SERIF};font-size:clamp(1.8rem, 4vw, 2.6rem);line-height:1.15;color:rgb(1,8,22);margin:0 0 12px 0;`}
    >
      Today's Annuity Rates
    </h1>
    <p
      style="color:rgb(100,116,139);font-size:16px;line-height:1.6;margin:0 0 8px 0;max-width:42rem;"
    >
      Best-available cap rates for fixed indexed annuities and guaranteed rates
      for multi-year guaranteed annuities (MYGAs), sourced from public carrier
      filings and industry aggregators. Updated {lastUpdated}.
    </p>
    <div
      style="font-size:12px;color:rgb(100,116,139);margin-bottom:40px;display:flex;align-items:center;gap:6px;"
    >
      <span aria-hidden="true">↻</span>
      Last updated: {lastUpdated} · Rates change weekly — verify with your
      carrier or advisor before acting.
    </div>

    {/* FIA TABLE */}
    <h2
      style={`font-family:${SERIF};font-size:20px;color:rgb(1,8,22);margin:0 0 16px 0;`}
    >
      Fixed Indexed Annuity — Best S&amp;P 500 Cap Rates by Term
    </h2>
    <div
      style="border-radius:12px;border:1px solid rgb(226,232,240);overflow:hidden;margin-bottom:8px;"
    >
      <div style="overflow-x:auto;">
        <table style="width:100%;border-collapse:collapse;font-size:14px;">
          <thead>
            <tr style="background:rgba(241,245,249,0.4);border-bottom:1px solid rgb(226,232,240);">
              <th style="text-align:left;padding:12px 16px;font-size:12px;font-weight:600;color:rgb(100,116,139);text-transform:uppercase;letter-spacing:0.05em;">Term</th>
              <th style="text-align:left;padding:12px 16px;font-size:12px;font-weight:600;color:rgb(100,116,139);text-transform:uppercase;letter-spacing:0.05em;">Best Cap Rate</th>
              <th style="text-align:left;padding:12px 16px;font-size:12px;font-weight:600;color:rgb(100,116,139);text-transform:uppercase;letter-spacing:0.05em;">Leading Carrier</th>
              <th style="text-align:left;padding:12px 16px;font-size:12px;font-weight:600;color:rgb(100,116,139);text-transform:uppercase;letter-spacing:0.05em;">AM Best</th>
              <th style="text-align:left;padding:12px 16px;font-size:12px;font-weight:600;color:rgb(100,116,139);text-transform:uppercase;letter-spacing:0.05em;">Notes</th>
            </tr>
          </thead>
          <tbody>
            {
              fiaRows.map((r, i) => (
                <tr style={`border-bottom:1px solid rgb(226,232,240);${i % 2 === 1 ? "background:rgba(241,245,249,0.1);" : ""}`}>
                  <td style="padding:12px 16px;font-weight:500;color:rgb(1,8,22);">{r.term}</td>
                  <td style="padding:12px 16px;font-weight:700;color:rgb(5,150,105);">{r.rate}</td>
                  <td style="padding:12px 16px;color:rgb(100,116,139);font-size:13px;">{r.carrier}</td>
                  <td style="padding:12px 16px;">
                    <span style={`display:inline-block;font-size:11px;font-weight:700;padding:3px 10px;border-radius:9999px;color:rgb(255,255,255);background:${badgeColor(r.amBest)};min-width:42px;text-align:center;`}>
                      {r.amBest}
                    </span>
                  </td>
                  <td style="padding:12px 16px;color:rgb(100,116,139);font-size:13px;">{r.note}</td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>
    </div>
    <p style="font-size:12px;color:rgb(100,116,139);margin:0 0 40px 0;">
      Source: annuity.org FIA rate tracker · S&amp;P 500 annual point-to-point
      crediting method · Rates subject to change without notice.
    </p>

    {/* MYGA TABLE */}
    <h2
      style={`font-family:${SERIF};font-size:20px;color:rgb(1,8,22);margin:0 0 16px 0;`}
    >
      Multi-Year Guaranteed Annuity (MYGA) Rates
    </h2>
    <p style="font-size:14px;color:rgb(100,116,139);margin:0 0 16px 0;max-width:42rem;line-height:1.6;">
      MYGAs offer a fixed, guaranteed interest rate for a set term — similar to
      a CD but tax-deferred. Rates below reflect best-available carrier
      offerings for $100,000+ premium tiers.
    </p>
    <div
      style="border-radius:12px;border:1px solid rgb(226,232,240);overflow:hidden;margin-bottom:8px;"
    >
      <div style="overflow-x:auto;">
        <table style="width:100%;border-collapse:collapse;font-size:14px;">
          <thead>
            <tr style="background:rgba(241,245,249,0.4);border-bottom:1px solid rgb(226,232,240);">
              <th style="text-align:left;padding:12px 16px;font-size:12px;font-weight:600;color:rgb(100,116,139);text-transform:uppercase;letter-spacing:0.05em;">Term</th>
              <th style="text-align:left;padding:12px 16px;font-size:12px;font-weight:600;color:rgb(100,116,139);text-transform:uppercase;letter-spacing:0.05em;">Rate</th>
              <th style="text-align:left;padding:12px 16px;font-size:12px;font-weight:600;color:rgb(100,116,139);text-transform:uppercase;letter-spacing:0.05em;">Carrier</th>
              <th class="rma-hide-sm" style="text-align:left;padding:12px 16px;font-size:12px;font-weight:600;color:rgb(100,116,139);text-transform:uppercase;letter-spacing:0.05em;">Product</th>
              <th style="text-align:left;padding:12px 16px;font-size:12px;font-weight:600;color:rgb(100,116,139);text-transform:uppercase;letter-spacing:0.05em;">AM Best</th>
            </tr>
          </thead>
          <tbody>
            {
              mygaRows.map((r, i) => (
                <tr style={`border-bottom:1px solid rgb(226,232,240);${i % 2 === 1 ? "background:rgba(241,245,249,0.1);" : ""}`}>
                  <td style="padding:12px 16px;font-weight:500;color:rgb(1,8,22);">{r.term}</td>
                  <td style="padding:12px 16px;font-weight:700;color:rgb(5,150,105);">{r.rate}</td>
                  <td style="padding:12px 16px;color:rgb(1,8,22);">{r.carrier}</td>
                  <td class="rma-hide-sm" style="padding:12px 16px;color:rgb(100,116,139);font-size:13px;">{r.product}</td>
                  <td style="padding:12px 16px;">
                    <span style={`display:inline-block;font-size:11px;font-weight:700;padding:3px 10px;border-radius:9999px;color:rgb(255,255,255);background:${badgeColor(r.amBest)};min-width:42px;text-align:center;`}>
                      {r.amBest}
                    </span>
                  </td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>
    </div>
    <p style="font-size:12px;color:rgb(100,116,139);margin:0 0 40px 0;">
      Source: RetireGuide, immediateannuities.com · Rates are current as of {lastUpdated} ·
      Verify directly with carrier.
    </p>

    {/* CALLOUT */}
    <section
      style="border-radius:12px;border:1px solid rgb(226,232,240);background:rgb(255,255,255);padding:32px;margin-bottom:32px;"
    >
      <h3
        style={`font-family:${SERIF};font-size:18px;color:rgb(1,8,22);margin:0 0 12px 0;`}
      >
        Cap Rate vs. Credited Return: the number that actually matters
      </h3>
      <p style="font-size:14px;color:rgb(100,116,139);line-height:1.65;margin:0 0 20px 0;">
        A cap rate is the upper bound — what your annuity could credit in a
        strong year. The credited return is what your contract actually delivers
        once the indexing method, participation rate, and spread are applied.
        Two contracts with the same cap rate can produce very different results
        in the same market.
      </p>
      <a
        href="/calculator"
        style="display:inline-flex;align-items:center;gap:6px;padding:12px 24px;border-radius:6px;background:rgb(15,23,42);color:rgb(247,249,251);font-size:14px;font-weight:500;text-decoration:none;"
      >
        Model a cap rate historically →
      </a>
    </section>

    {/* DISCLAIMER */}
    <p style="font-size:12px;color:rgb(100,116,139);line-height:1.65;max-width:42rem;">
      Rates shown are illustrative of best-available market conditions and are
      compiled from public aggregators including annuity.org and RetireGuide.
      They do not represent specific product offers and are not guaranteed.
      Annuity rates reset periodically and can change without notice. This page
      is for informational purposes only and does not constitute financial
      advice. Always consult a licensed financial professional before
      purchasing an annuity.
    </p>
  </main>
</BaseLayout>

<style>
  @media (max-width: 640px) {
    .rma-hide-sm {
      display: none;
    }
  }
</style>
