---
import BaseLayout from "../layouts/BaseLayout.astro";

const fontSerif = "'DM Serif Display', Georgia, serif";
---
<BaseLayout
  title="RankMyAnnuity — Free Annuity Calculator & FIA Rate Rankings"
  description="Calculate the true implied rate of return on any income annuity and model how caps, spreads, and participation rates affect credited returns across 64 FIA indexes."
  canonicalPath="/"
>
  <!-- Ensure DM Serif Display + DM Sans are available even if BaseLayout doesn't load them -->
  <link slot="head" rel="preconnect" href="https://fonts.googleapis.com" />
  <link slot="head" rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link slot="head" rel="stylesheet" href="https://fonts.googleapis.com/css2?family=DM+Serif+Display:ital@0;1&family=DM+Sans:ital,opsz,wght@0,9..40,300..700;1,9..40,300..700&display=swap" />

  <div style="font-family:'DM Sans',ui-sans-serif,system-ui,sans-serif;color:rgb(2,8,23);background:rgb(255,255,255);">

    <!-- ============================================================ -->
    <!-- HERO -->
    <!-- ============================================================ -->
    <section style="background-image:linear-gradient(to bottom, rgb(255,255,255), rgba(241,245,249,0.5));border-bottom:1px solid rgb(226,232,240);">
      <div style="max-width:1024px;margin:0 auto;padding:80px 24px;">
        <p style="font-size:14px;font-weight:500;color:rgb(249,112,21);text-transform:uppercase;letter-spacing:0.16em;margin:0 0 16px;">
          Free Annuity Analysis Tools
        </p>
        <h1 style={`font-family:${fontSerif};font-weight:400;font-size:clamp(2.4rem, 5.2vw, 4rem);line-height:1.05;color:rgb(2,8,23);max-width:760px;margin:0 0 24px;letter-spacing:-0.01em;`}>
          What is your annuity <span style="font-style:italic;">really</span> paying you?
        </h1>
        <p style="font-size:18px;line-height:1.6;color:rgb(71,85,105);max-width:640px;margin:0 0 32px;">
          Two tools in one: calculate the true implied IRR on any income annuity or pension, and model how cap rates, spreads, and participation rates affect credited returns across 64 FIA indexes — with side-by-side comparison and $100K growth charts.
        </p>
        <div style="display:flex;flex-wrap:wrap;gap:12px;">
          <a href="/calculator" style="display:inline-flex;align-items:center;gap:8px;padding:12px 22px;border-radius:8px;background:rgb(15,23,42);color:rgb(248,250,252);font-weight:500;font-size:15px;border:1px solid rgb(15,23,42);text-decoration:none;transition:opacity 0.15s;">
            Grade My Annuity
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
          </a>
          <a href="/how-it-works" style="display:inline-flex;align-items:center;gap:8px;padding:12px 22px;border-radius:8px;background:transparent;color:rgb(2,8,23);font-weight:500;font-size:15px;border:1px solid rgb(226,232,240);text-decoration:none;transition:background-color 0.15s;">
            How It Works
          </a>
        </div>
      </div>
    </section>

    <!-- ============================================================ -->
    <!-- STATS STRIP -->
    <!-- ============================================================ -->
    <section style="background-color:rgba(241,245,249,0.45);border-bottom:1px solid rgb(226,232,240);">
      <div style="max-width:1024px;margin:0 auto;padding:36px 24px;display:grid;grid-template-columns:repeat(3, minmax(0, 1fr));gap:24px;">
        <div>
          <div style={`font-family:${fontSerif};font-weight:400;font-size:clamp(2rem, 4vw, 2.75rem);color:rgb(2,8,23);line-height:1.1;`}>$400B+</div>
          <div style="font-size:14px;color:rgb(71,85,105);margin-top:6px;">Annual U.S. annuity sales</div>
        </div>
        <div>
          <div style={`font-family:${fontSerif};font-weight:400;font-size:clamp(2rem, 4vw, 2.75rem);color:rgb(2,8,23);line-height:1.1;`}>64</div>
          <div style="font-size:14px;color:rgb(71,85,105);margin-top:6px;">FIA indexes modeled with crediting analysis</div>
        </div>
        <div>
          <div style={`font-family:${fontSerif};font-weight:400;font-size:clamp(2rem, 4vw, 2.75rem);color:rgb(2,8,23);line-height:1.1;`}>~60%<sup style="font-size:0.55em;font-weight:400;color:rgb(15,23,42);margin-left:2px;">*</sup></div>
          <div style="font-size:14px;color:rgb(71,85,105);margin-top:6px;">Buyers who don&rsquo;t know their true yield</div>
        </div>
      </div>
    </section>

    <!-- ============================================================ -->
    <!-- INCOME & IRR CALCULATOR -->
    <!-- ============================================================ -->
    <section style="max-width:1024px;margin:0 auto;padding:64px 24px 40px;">
      <div style="display:flex;align-items:flex-end;justify-content:space-between;gap:16px;flex-wrap:wrap;">
        <h2 style={`font-family:${fontSerif};font-weight:400;font-size:28px;color:rgb(2,8,23);margin:0;line-height:1.2;`}>
          Income &amp; IRR Calculator
        </h2>
        <a href="/calculator" style="display:inline-flex;align-items:center;gap:6px;font-size:14px;font-weight:500;color:rgb(15,23,42);text-decoration:none;">
          Open calculator
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
        </a>
      </div>
      <p style="font-size:15px;line-height:1.6;color:rgb(71,85,105);max-width:680px;margin:12px 0 32px;">
        The only free tool that solves for the true implied rate of return on any income annuity, deferred annuity, or pension offer — and grades it against current alternatives.
      </p>

      <div style="display:grid;grid-template-columns:repeat(2, minmax(0, 1fr));gap:20px;">
        <div style="padding:24px;border-radius:10px;border:1px solid rgb(226,232,240);background:rgb(255,255,255);">
          <div style="width:36px;height:36px;border-radius:8px;background:rgb(241,245,249);display:flex;align-items:center;justify-content:center;color:rgb(15,23,42);margin-bottom:16px;">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 3v16a2 2 0 0 0 2 2h16"/><path d="M18 17V9"/><path d="M13 17V5"/><path d="M8 17v-3"/></svg>
          </div>
          <h3 style="font-size:16px;font-weight:600;color:rgb(2,8,23);margin:0 0 8px;">True Yield — Not Payout Rate</h3>
          <p style="font-size:14px;line-height:1.65;color:rgb(71,85,105);margin:0;">
            That 7% payout rate you&rsquo;re seeing includes return of your own principal. We solve for the real implied IRR so you know what you&rsquo;re actually earning.
          </p>
        </div>
        <div style="padding:24px;border-radius:10px;border:1px solid rgb(226,232,240);background:rgb(255,255,255);">
          <div style="width:36px;height:36px;border-radius:8px;background:rgb(241,245,249);display:flex;align-items:center;justify-content:center;color:rgb(15,23,42);margin-bottom:16px;">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="22 7 13.5 15.5 8.5 10.5 2 17"/><polyline points="16 7 22 7 22 13"/></svg>
          </div>
          <h3 style="font-size:16px;font-weight:600;color:rgb(2,8,23);margin:0 0 8px;">Benchmark Against the Market</h3>
          <p style="font-size:14px;line-height:1.65;color:rgb(71,85,105);margin:0;">
            Your result is graded against top MYGAs, 10-yr Treasuries, and 5-yr CDs in real time — so you can see whether your annuity is actually competitive.
          </p>
        </div>
        <div style="padding:24px;border-radius:10px;border:1px solid rgb(226,232,240);background:rgb(255,255,255);">
          <div style="width:36px;height:36px;border-radius:8px;background:rgb(241,245,249);display:flex;align-items:center;justify-content:center;color:rgb(15,23,42);margin-bottom:16px;">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 13c0 5-3.5 7.5-7.66 8.95a1 1 0 0 1-.67-.01C7.5 20.5 4 18 4 13V6a1 1 0 0 1 1-1c2 0 4.5-1.2 6.24-2.72a1.17 1.17 0 0 1 1.52 0C14.51 3.81 17 5 19 5a1 1 0 0 1 1 1z"/><path d="m9 12 2 2 4-4"/></svg>
          </div>
          <h3 style="font-size:16px;font-weight:600;color:rgb(2,8,23);margin:0 0 8px;">Works for Pensions Too</h3>
          <p style="font-size:14px;line-height:1.65;color:rgb(71,85,105);margin:0;">
            Evaluating a pension buyout or lump sum vs. monthly income? Enter the numbers the same way — the present value math is identical.
          </p>
        </div>
        <div style="padding:24px;border-radius:10px;border:1px solid rgb(226,232,240);background:rgb(255,255,255);">
          <div style="width:36px;height:36px;border-radius:8px;background:rgb(241,245,249);display:flex;align-items:center;justify-content:center;color:rgb(15,23,42);margin-bottom:16px;">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m21.73 18-8-14a2 2 0 0 0-3.48 0l-8 14A2 2 0 0 0 4 21h16a2 2 0 0 0 1.73-3"/><path d="M12 9v4"/><path d="M12 17h.01"/></svg>
          </div>
          <h3 style="font-size:16px;font-weight:600;color:rgb(2,8,23);margin:0 0 8px;">No Sales Agenda</h3>
          <p style="font-size:14px;line-height:1.65;color:rgb(71,85,105);margin:0;">
            We don&rsquo;t sell annuities, earn commissions, or refer leads. The tool exists to help you make a better-informed decision, full stop.
          </p>
        </div>
      </div>
    </section>

    <!-- ============================================================ -->
    <!-- FIA INDEX PERFORMANCE CALCULATOR -->
    <!-- ============================================================ -->
    <section style="max-width:1024px;margin:0 auto;padding:40px 24px 64px;border-top:1px solid rgb(241,245,249);">
      <div style="display:flex;align-items:flex-end;justify-content:space-between;gap:16px;flex-wrap:wrap;padding-top:24px;">
        <h2 style={`font-family:${fontSerif};font-weight:400;font-size:28px;color:rgb(2,8,23);margin:0;line-height:1.2;`}>
          FIA Index Performance Calculator
        </h2>
        <a href="/calculator" style="display:inline-flex;align-items:center;gap:6px;font-size:14px;font-weight:500;color:rgb(15,23,42);text-decoration:none;">
          Open calculator
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
        </a>
      </div>
      <p style="font-size:15px;line-height:1.6;color:rgb(71,85,105);max-width:680px;margin:12px 0 32px;">
        Fixed Indexed Annuities credit interest based on an index — but caps, spreads, and participation rates mean you rarely capture the full return. Model exactly what you would have received, historically, across 64 indexes.
      </p>

      <div style="display:grid;grid-template-columns:repeat(2, minmax(0, 1fr));gap:20px;">
        <div style="padding:24px;border-radius:10px;border:1px solid rgb(226,232,240);background:rgb(255,255,255);">
          <div style="width:36px;height:36px;border-radius:8px;background:rgb(241,245,249);display:flex;align-items:center;justify-content:center;color:rgb(15,23,42);margin-bottom:16px;">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/></svg>
          </div>
          <h3 style="font-size:16px;font-weight:600;color:rgb(2,8,23);margin:0 0 8px;">64 Indexes — Searchable</h3>
          <p style="font-size:14px;line-height:1.65;color:rgb(71,85,105);margin:0;">
            From S&amp;P 500 and Nasdaq-100 to proprietary indexes like JPM Mozaic II, Bloomberg Dynamic Balance II, and Goldman Sachs New Horizons. Search by name or issuer instantly.
          </p>
        </div>
        <div style="padding:24px;border-radius:10px;border:1px solid rgb(226,232,240);background:rgb(255,255,255);">
          <div style="width:36px;height:36px;border-radius:8px;background:rgb(241,245,249);display:flex;align-items:center;justify-content:center;color:rgb(15,23,42);margin-bottom:16px;">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 3v16a2 2 0 0 0 2 2h16"/><path d="M18 17V9"/><path d="M13 17V5"/><path d="M8 17v-3"/></svg>
          </div>
          <h3 style="font-size:16px;font-weight:600;color:rgb(2,8,23);margin:0 0 8px;">Model Any Crediting Method</h3>
          <p style="font-size:14px;line-height:1.65;color:rgb(71,85,105);margin:0;">
            Enter a cap rate, spread, or participation rate and see exactly what would have been credited each year — versus what the index actually returned.
          </p>
        </div>
        <div style="padding:24px;border-radius:10px;border:1px solid rgb(226,232,240);background:rgb(255,255,255);">
          <div style="width:36px;height:36px;border-radius:8px;background:rgb(241,245,249);display:flex;align-items:center;justify-content:center;color:rgb(15,23,42);margin-bottom:16px;">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 3v16a2 2 0 0 0 2 2h16"/><path d="m19 9-5 5-4-4-3 3"/></svg>
          </div>
          <h3 style="font-size:16px;font-weight:600;color:rgb(2,8,23);margin:0 0 8px;">$100K Growth Chart</h3>
          <p style="font-size:14px;line-height:1.65;color:rgb(71,85,105);margin:0;">
            A visual line chart shows how a $100,000 investment would have grown under the raw index vs. your crediting strategy — making the cost of constraints immediately visible.
          </p>
        </div>
        <div style="padding:24px;border-radius:10px;border:1px solid rgb(226,232,240);background:rgb(255,255,255);">
          <div style="width:36px;height:36px;border-radius:8px;background:rgb(241,245,249);display:flex;align-items:center;justify-content:center;color:rgb(15,23,42);margin-bottom:16px;">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="18" cy="18" r="3"/><circle cx="6" cy="6" r="3"/><path d="M13 6h3a2 2 0 0 1 2 2v7"/><path d="M11 18H8a2 2 0 0 1-2-2V9"/></svg>
          </div>
          <h3 style="font-size:16px;font-weight:600;color:rgb(2,8,23);margin:0 0 8px;">Compare Any Two Strategies</h3>
          <p style="font-size:14px;line-height:1.65;color:rgb(71,85,105);margin:0;">
            Put two different indexes and crediting methods side by side. See which would have credited more, and by how much, across the same historical period.
          </p>
        </div>
      </div>
    </section>

    <!-- ============================================================ -->
    <!-- PRODUCT REVIEWS -->
    <!-- ============================================================ -->
    <section style="max-width:1024px;margin:0 auto;padding:40px 24px 64px;">
      <div style="display:flex;align-items:flex-end;justify-content:space-between;gap:16px;flex-wrap:wrap;margin-bottom:24px;">
        <div>
          <h2 style={`font-family:${fontSerif};font-weight:400;font-size:28px;color:rgb(2,8,23);margin:0;line-height:1.2;`}>Product Reviews</h2>
          <p style="font-size:14px;color:rgb(71,85,105);max-width:560px;margin:8px 0 0;">Independent reviews of the top FIA and variable annuity products from 20 carriers.</p>
        </div>
        <a href="/reviews" style="display:inline-flex;align-items:center;gap:6px;font-size:14px;font-weight:500;color:rgb(15,23,42);white-space:nowrap;text-decoration:none;">
          All reviews
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
        </a>
      </div>

      <div style="display:grid;grid-template-columns:repeat(3, minmax(0, 1fr));gap:16px;">
        <a href="/learn/best-fixed-indexed-annuities" style="display:flex;flex-direction:column;gap:8px;padding:20px;border-radius:10px;border:1px solid rgb(226,232,240);background:rgb(255,255,255);height:100%;color:inherit;text-decoration:none;">
          <div style="display:flex;align-items:center;gap:8px;">
            <div style="width:28px;height:28px;border-radius:6px;background:rgb(241,245,249);display:flex;align-items:center;justify-content:center;color:rgb(15,23,42);opacity:0.7;flex-shrink:0;">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M15 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7Z"/><path d="M14 2v4a2 2 0 0 0 2 2h4"/><path d="M10 9H8"/><path d="M16 13H8"/><path d="M16 17H8"/></svg>
            </div>
            <span style="font-size:10px;font-weight:700;text-transform:uppercase;letter-spacing:0.16em;color:rgb(249,112,21);">Guide</span>
          </div>
          <div style="font-size:14px;font-weight:600;color:rgb(2,8,23);">Best FIAs in 2026</div>
          <div style="font-size:12px;line-height:1.6;color:rgb(71,85,105);flex:1;">Top 10 fixed indexed annuity carriers ranked by sales, ratings, and product quality — with comparison tables.</div>
          <div style="font-size:12px;font-weight:500;color:rgb(15,23,42);display:inline-flex;align-items:center;gap:4px;margin-top:4px;">
            Read
            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
          </div>
        </a>

        <a href="/learn/best-variable-annuities" style="display:flex;flex-direction:column;gap:8px;padding:20px;border-radius:10px;border:1px solid rgb(226,232,240);background:rgb(255,255,255);height:100%;color:inherit;text-decoration:none;">
          <div style="display:flex;align-items:center;gap:8px;">
            <div style="width:28px;height:28px;border-radius:6px;background:rgb(241,245,249);display:flex;align-items:center;justify-content:center;color:rgb(15,23,42);opacity:0.7;flex-shrink:0;">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M15 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7Z"/><path d="M14 2v4a2 2 0 0 0 2 2h4"/><path d="M10 9H8"/><path d="M16 13H8"/><path d="M16 17H8"/></svg>
            </div>
            <span style="font-size:10px;font-weight:700;text-transform:uppercase;letter-spacing:0.16em;color:rgb(249,112,21);">Guide</span>
          </div>
          <div style="font-size:14px;font-weight:600;color:rgb(2,8,23);">Best VAs in 2026</div>
          <div style="font-size:12px;line-height:1.6;color:rgb(71,85,105);flex:1;">The leading variable annuity and RILA carriers compared on fees, features, and financial strength.</div>
          <div style="font-size:12px;font-weight:500;color:rgb(15,23,42);display:inline-flex;align-items:center;gap:4px;margin-top:4px;">
            Read
            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
          </div>
        </a>

        <a href="/learn/fia-vs-rila" style="display:flex;flex-direction:column;gap:8px;padding:20px;border-radius:10px;border:1px solid rgb(226,232,240);background:rgb(255,255,255);height:100%;color:inherit;text-decoration:none;">
          <div style="display:flex;align-items:center;gap:8px;">
            <div style="width:28px;height:28px;border-radius:6px;background:rgb(241,245,249);display:flex;align-items:center;justify-content:center;color:rgb(15,23,42);opacity:0.7;flex-shrink:0;">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M15 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7Z"/><path d="M14 2v4a2 2 0 0 0 2 2h4"/><path d="M10 9H8"/><path d="M16 13H8"/><path d="M16 17H8"/></svg>
            </div>
            <span style="font-size:10px;font-weight:700;text-transform:uppercase;letter-spacing:0.16em;color:rgb(249,112,21);">Guide</span>
          </div>
          <div style="font-size:14px;font-weight:600;color:rgb(2,8,23);">FIA vs. RILA</div>
          <div style="font-size:12px;line-height:1.6;color:rgb(71,85,105);flex:1;">100% principal protection vs. buffer protection — which annuity type is right for your situation?</div>
          <div style="font-size:12px;font-weight:500;color:rgb(15,23,42);display:inline-flex;align-items:center;gap:4px;margin-top:4px;">
            Read
            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
          </div>
        </a>

        <a href="/reviews/athene" style="display:flex;flex-direction:column;gap:8px;padding:20px;border-radius:10px;border:1px solid rgb(226,232,240);background:rgb(255,255,255);height:100%;color:inherit;text-decoration:none;">
          <div style="display:flex;align-items:center;gap:8px;">
