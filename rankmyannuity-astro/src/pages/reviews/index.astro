---
// /reviews — index of carrier and product reviews.
// Carrier reviews and product reviews are shown in separate buckets.
// Richer faceting (product type, surrender length) is a later-phase concern.
import BaseLayout from '@layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const all = (
  await getCollection('reviews', (e) =>
    import.meta.env.PROD ? e.data.draft !== true : true,
  )
).sort(
  (a, b) => b.data.updatedAt.getTime() - a.data.updatedAt.getTime(),
);
const carriers = all.filter((r) => r.data.kind === 'carrier');
const products = all.filter((r) => r.data.kind === 'product');
---
<BaseLayout
  title="Reviews — Carriers and products"
  description="Independent reviews of annuity carriers and products. Example content during Phase 2 migration."
  canonicalPath="/reviews"
>
  <section class="mx-auto max-w-3xl px-4 py-10">
    <h1 class="text-3xl font-semibold">Reviews</h1>
    <p class="mt-2 text-sm text-[var(--muted)]">
      Example content only during the Phase 2 migration.
    </p>

    <h2 class="mt-8 text-xl font-semibold">Carriers</h2>
    {carriers.length === 0 ? (
      <p class="mt-2 text-[var(--muted)]">No carrier reviews yet.</p>
    ) : (
      <ul class="mt-3 space-y-4">
        {carriers.map((r) => (
          <li>
            <a href={`/reviews/${r.data.slug ?? r.slug}`} class="font-semibold">
              {r.data.title}
            </a>
            <p class="text-sm text-[var(--muted)]">{r.data.description}</p>
          </li>
        ))}
      </ul>
    )}

    <h2 class="mt-10 text-xl font-semibold">Products</h2>
    {products.length === 0 ? (
      <p class="mt-2 text-[var(--muted)]">No product reviews yet.</p>
    ) : (
      <ul class="mt-3 space-y-4">
        {products.map((r) => (
          <li>
            <a href={`/reviews/${r.data.slug ?? r.slug}`} class="font-semibold">
              {r.data.title}
            </a>
            <p class="text-sm text-[var(--muted)]">{r.data.description}</p>
          </li>
        ))}
      </ul>
    )}
  </section>
</BaseLayout>
