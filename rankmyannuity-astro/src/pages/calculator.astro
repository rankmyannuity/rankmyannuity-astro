---
import BaseLayout from "../layouts/BaseLayout.astro";

const title = "Annuity Calculator — IRR Grader & FIA Index Modeler | RankMyAnnuity";
const description =
  "Two tools: calculate the implied IRR on any income annuity (graded A+ to F against benchmarks), and model FIA crediting constraints across 64 indexes with real historical data.";

const SERIF = "'DM Serif Display', Georgia, serif";

const examples = [
  {
    label: "Typical SPIA",
    sub: "Single-premium immediate annuity, average market rate.",
    premium: "$100,000",
    payout: "$520/mo",
    duration: "20 yrs",
  },
  {
    label: "Good MYGA-like",
    sub: "Multi-year guaranteed annuity with strong implied yield.",
    premium: "$100,000",
    payout: "$650/mo",
    duration: "20 yrs",
  },
  {
    label: "Poor offer",
    sub: "Low-rate offer dressed up with a long deferral.",
    premium: "$100,000",
    payout: "$400/mo",
    duration: "20 yrs",
  },
];

const benchmarks = [
  { label: "5-yr MYGA (top rate)", value: "5.90%" },
  { label: "10-yr Treasury", value: "4.35%" },
  { label: "5-yr CD (national avg)", value: "4.55%" },
  { label: "S&P 500 (historical)", value: "10.00%" },
];
---

<BaseLayout title={title} description={description}>
  <link
    slot="head"
    rel="preconnect"
    href="https://fonts.googleapis.com"
  />
  <link
    slot="head"
    rel="preconnect"
    href="https://fonts.gstatic.com"
    crossorigin
  />
  <link
    slot="head"
    rel="stylesheet"
    href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=DM+Serif+Display:ital@0;1&display=swap"
  />

  <main
    style="max-width:1024px;margin:0 auto;padding:40px 24px;color:rgb(1,8,22);font-family:'DM Sans',ui-sans-serif,system-ui,sans-serif;"
  >
    {/* Eyebrow + heading */}
    <div
      style="margin-bottom:8px;font-size:12px;font-weight:500;color:rgb(249,112,21);text-transform:uppercase;letter-spacing:0.1em;"
    >
      Free Annuity Analysis Tools
    </div>
    <h1
      style={`font-family:${SERIF};font-size:clamp(1.8rem, 4vw, 2.5rem);color:rgb(1,8,22);margin:0 0 8px 0;line-height:1.15;`}
    >
      Annuity Grade Calculator
    </h1>
    <p
      style="color:rgb(100,116,139);font-size:16px;line-height:1.6;margin:0 0 32px 0;max-width:42rem;"
    >
      Enter your annuity terms to calculate the true implied rate of return and
      see how it stacks up.
    </p>

    {/* Tab switcher */}
    <div style="display:flex;gap:8px;margin-bottom:24px;">
      <button
        type="button"
        style="padding:10px 16px;border-radius:6px;background:rgb(15,23,42);color:rgb(247,249,251);font-size:14px;font-weight:500;border:0;cursor:pointer;"
      >
        Income / IRR
      </button>
      <button
        type="button"
        style="padding:10px 16px;border-radius:6px;background:transparent;color:rgb(1,8,22);font-size:14px;font-weight:500;border:1px solid rgb(226,232,240);cursor:pointer;"
      >
        Index Modeler
      </button>
    </div>

    {/* Two-column grid: form (3/5) + results (2/5) */}
    <div class="rma-grid">
      {/* FORM */}
      <section
        style="border-radius:12px;border:1px solid rgb(226,232,240);background:rgb(255,255,255);padding:32px;"
      >
        <h2
          style="font-size:16px;font-weight:600;color:rgb(1,8,22);margin:0 0 20px 0;"
        >
          Your Annuity Terms
        </h2>

        <form id="rma-calc-form" class="rma-input-grid">
          {/* Premium */}
          <label class="rma-field">
            <span class="rma-label">Premium (lump sum paid)</span>
            <span class="rma-input-wrap">
              <span class="rma-affix">$</span>
              <input
                type="number"
                inputmode="numeric"
                placeholder="100000"
                aria-label="Premium"
              />
            </span>
          </label>

          {/* Deferral years */}
          <label class="rma-field">
            <span class="rma-label">Deferral Period</span>
            <span class="rma-input-wrap">
              <input
                type="number"
                inputmode="numeric"
                placeholder="0"
                aria-label="Deferral years"
              />
              <span class="rma-affix" style="border-left:1px solid rgb(226,232,240);border-right:0;">
                years
              </span>
            </span>
          </label>

          {/* Monthly payout */}
          <label class="rma-field">
            <span class="rma-label">Monthly Payout</span>
            <span class="rma-input-wrap">
              <span class="rma-affix">$</span>
              <input
                type="number"
                inputmode="numeric"
                placeholder="600"
                aria-label="Monthly payout"
              />
            </span>
          </label>

          {/* Payout duration */}
          <label class="rma-field">
            <span class="rma-label">Payout Duration</span>
            <span class="rma-input-wrap">
              <input
                type="number"
                inputmode="numeric"
                placeholder="20"
                aria-label="Payout years"
              />
              <span class="rma-affix" style="border-left:1px solid rgb(226,232,240);border-right:0;">
                years
              </span>
            </span>
          </label>
        </form>

        {/* Action buttons */}
        <div style="display:flex;gap:8px;margin-top:24px;">
          <button
            type="submit"
            form="rma-calc-form"
            style="flex:1;padding:12px 16px;border-radius:6px;background:rgb(15,23,42);color:rgb(247,249,251);font-size:14px;font-weight:500;border:0;cursor:pointer;"
          >
            Calculate Grade
          </button>
          <button
            type="reset"
            form="rma-calc-form"
            style="padding:12px 16px;border-radius:6px;background:transparent;color:rgb(1,8,22);font-size:14px;font-weight:500;border:1px solid rgb(226,232,240);cursor:pointer;"
          >
            Reset
          </button>
        </div>
      </section>

      {/* RESULTS */}
      <aside
        style="border-radius:12px;border:1px solid rgb(226,232,240);background:rgb(255,255,255);padding:32px;display:flex;flex-direction:column;gap:24px;"
      >
        <div
          style="display:flex;flex-direction:column;align-items:center;justify-content:center;text-align:center;padding:24px 8px;border-radius:8px;background:rgba(241,245,249,0.5);"
        >
          <div
            style={`font-family:${SERIF};font-size:64px;color:rgb(100,116,139);line-height:1;margin-bottom:8px;`}
          >
            ?
          </div>
          <div style="color:rgb(100,116,139);font-size:14px;">
            Enter your annuity terms and hit Calculate.
          </div>
        </div>

        <div>
          <h3
            style="font-size:14px;font-weight:600;color:rgb(1,8,22);margin:0 0 4px 0;"
          >
            Market Benchmarks
          </h3>
          <p
            style="font-size:12px;color:rgb(100,116,139);margin:0 0 12px 0;"
          >
            How your implied rate compares.
          </p>
          <ul
            style="list-style:none;padding:0;margin:0;display:flex;flex-direction:column;gap:8px;"
          >
            {
              benchmarks.map((b) => (
                <li style="display:flex;justify-content:space-between;align-items:baseline;font-size:14px;border-bottom:1px solid rgb(226,232,240);padding:8px 0;">
                  <span style="color:rgb(100,116,139);">{b.label}</span>
                  <span style="font-weight:500;color:rgb(1,8,22);">{b.value}</span>
                </li>
              ))
            }
          </ul>
        </div>
      </aside>
    </div>

    {/* Try an example */}
    <section style="margin-top:40px;">
      <h2
        style={`font-family:${SERIF};font-size:20px;color:rgb(1,8,22);margin:0 0 16px 0;`}
      >
        Try an Example
      </h2>
      <div class="rma-example-grid">
        {
          examples.map((ex) => (
            <button
              type="button"
              style="text-align:left;padding:20px;border-radius:8px;border:1px solid rgb(226,232,240);background:rgb(255,255,255);cursor:pointer;display:flex;flex-direction:column;gap:8px;font-family:inherit;"
            >
              <span style="font-size:14px;font-weight:600;color:rgb(1,8,22);">
                {ex.label}
              </span>
              <span style="font-size:13px;color:rgb(100,116,139);line-height:1.5;">
                {ex.sub}
              </span>
              <span
                style="font-size:12px;color:rgb(100,116,139);margin-top:auto;padding-top:8px;border-top:1px solid rgb(226,232,240);"
              >
                {ex.premium} · {ex.payout} · {ex.duration}
              </span>
            </button>
          ))
        }
      </div>
    </section>

    {/* Grading scale */}
    <section
      style="margin-top:40px;padding:24px;border-radius:12px;border:1px solid rgb(226,232,240);background:rgba(241,245,249,0.4);"
    >
      <h2
        style={`font-family:${SERIF};font-size:18px;color:rgb(1,8,22);margin:0 0 12px 0;`}
      >
        Grading scale
      </h2>
      <div
        style="display:grid;grid-template-columns:repeat(auto-fit, minmax(140px,1fr));gap:12px;font-size:13px;"
      >
        <div>
          <div style="font-weight:600;color:rgb(5,150,105);">A+ — ≥ 8%</div>
          <div style="color:rgb(100,116,139);">Exceptional</div>
        </div>
        <div>
          <div style="font-weight:600;color:rgb(16,185,129);">A — 6–8%</div>
          <div style="color:rgb(100,116,139);">Strong</div>
        </div>
        <div>
          <div style="font-weight:600;color:rgb(1,8,22);">B — 4–6%</div>
          <div style="color:rgb(100,116,139);">Fair</div>
        </div>
        <div>
          <div style="font-weight:600;color:rgb(245,158,11);">C — 2–4%</div>
          <div style="color:rgb(100,116,139);">Below average</div>
        </div>
        <div>
          <div style="font-weight:600;color:rgb(220,38,38);">F — &lt; 2%</div>
          <div style="color:rgb(100,116,139);">Poor</div>
        </div>
      </div>
    </section>
  </main>
</BaseLayout>

<style>
  .rma-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 24px;
  }
  @media (min-width: 1024px) {
    .rma-grid {
      grid-template-columns: 3fr 2fr;
      gap: 32px;
    }
  }

  .rma-input-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 16px;
  }
  @media (min-width: 640px) {
    .rma-input-grid {
      grid-template-columns: 1fr 1fr;
    }
  }

  .rma-field {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }
  .rma-label {
    font-size: 14px;
    font-weight: 500;
    color: rgb(1, 8, 22);
  }
  .rma-input-wrap {
    display: flex;
    align-items: stretch;
    border: 1px solid rgb(226, 232, 240);
    border-radius: 6px;
    background: rgb(255, 255, 255);
    overflow: hidden;
  }
  .rma-input-wrap:focus-within {
    box-shadow: 0 0 0 2px rgba(15, 23, 42, 0.15);
    border-color: rgb(15, 23, 42);
  }
  .rma-input-wrap input {
    flex: 1;
    min-width: 0;
    padding: 10px 12px;
    font-size: 14px;
    color: rgb(1, 8, 22);
    background: transparent;
    border: 0;
    outline: 0;
    font-family: inherit;
  }
  .rma-input-wrap input::placeholder {
    color: rgb(148, 163, 184);
  }
  .rma-affix {
    display: inline-flex;
    align-items: center;
    padding: 0 12px;
    background: rgb(241, 245, 249);
    color: rgb(100, 116, 139);
    font-size: 14px;
    border-right: 1px solid rgb(226, 232, 240);
    user-select: none;
  }

  .rma-example-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 12px;
  }
  @media (min-width: 640px) {
    .rma-example-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }
  .rma-example-grid button:hover {
    border-color: rgba(15, 23, 42, 0.4);
  }
</style>
