---
// Terms of Service — content ported from the prior React build at
// _deploy_old/terms/. Styled to match /about, /methodology, /privacy.
import BaseLayout from "../layouts/BaseLayout.astro";

const title = "Terms of Service | RankMyAnnuity";
const description =
  "Terms governing your use of RankMyAnnuity.pro — informational purpose, no advisory relationship, limits of liability, and intellectual property.";

const SERIF = "'DM Serif Display', Georgia, serif";

const h2Style = `font-family:${SERIF};font-size:24px;color:rgb(1,8,22);margin:32px 0 12px 0;font-weight:400;`;
const pStyle = "color:rgb(100,116,139);font-size:16px;line-height:1.7;margin:0 0 16px 0;";
const linkStyle = "color:rgb(1,8,22);text-decoration:underline;text-underline-offset:2px;";

const sections: { heading: string; paragraphs: string[] }[] = [
  {
    heading: "1. Informational Purpose Only",
    paragraphs: [
      "The Site and all content, tools, calculators, ratings, grades, comparisons, and articles published on it are provided for informational and educational purposes only. Nothing on this Site constitutes financial advice, investment advice, insurance advice, tax advice, or legal advice.",
      "The IRR calculations, letter grades, index modeling outputs, and any other analytical content are mathematical tools intended to help you understand the quantitative characteristics of annuity products. They are not recommendations to buy, sell, or hold any financial product.",
    ],
  },
  {
    heading: "2. No Fiduciary or Advisory Relationship",
    paragraphs: [
      "Use of this Site does not create a fiduciary relationship, an advisory relationship, a client relationship, or any other professional relationship between you and Pacific Northwest Analytics LLC or any person associated with the Site.",
      "The content on this Site is general in nature and does not take into account your individual financial situation, goals, risk tolerance, tax circumstances, or any other personal factors. Before making any financial or insurance decision, consult a licensed financial professional who can evaluate your specific circumstances.",
    ],
  },
  {
    heading: "3. Accuracy of Information",
    paragraphs: [
      "Pacific Northwest Analytics LLC makes reasonable efforts to ensure that the information published on this Site is accurate and up to date, including annuity product terms, benchmark rates, carrier ratings, and index data. However, we make no representation or warranty, express or implied, regarding the completeness, accuracy, reliability, suitability, or availability of any information on the Site.",
      "Annuity product terms change. Carrier rates are updated periodically and may not reflect current offerings at any given moment. Benchmark rates (Treasury yields, CD rates, MYGA rates) are snapshots in time and will drift from the rates shown as market conditions change.",
      "You are responsible for independently verifying any information before relying on it for any financial decision.",
    ],
  },
  {
    heading: "4. No Product Endorsement",
    paragraphs: [
      "The appearance of any annuity product, carrier, or financial institution on this Site does not constitute an endorsement, recommendation, or approval of that product or company. Letter grades and IRR calculations reflect mathematical analysis only — they are not endorsements.",
      "A high grade means an annuity's implied yield compares favorably to current benchmarks under the assumptions described in our methodology. It is not a statement that the product is suitable for any particular investor, that the carrier is financially sound, or that the product is free of risks, fees, or contractual limitations not captured in the calculation.",
    ],
  },
  {
    heading: "5. User Responsibility",
    paragraphs: [
      "You assume sole responsibility for any financial decisions you make based on information obtained from this Site. Pacific Northwest Analytics LLC is not liable for any financial loss, missed opportunity, tax consequence, or other outcome resulting from your use of, or reliance on, any content, tool, or calculation provided here.",
      "The FIA Index Calculator uses historical index data to illustrate how crediting constraints affect returns. Past index performance does not predict future results. No output from this Site should be interpreted as a projection, forecast, or guarantee of future annuity performance.",
    ],
  },
  {
    heading: "6. Intellectual Property",
    paragraphs: [
      "All content on this Site — including but not limited to text, calculations, grading methodology, tool designs, graphics, and editorial articles — is the property of Pacific Northwest Analytics LLC and is protected by applicable copyright and intellectual property law.",
      "You may view and use Site content for your own personal, non-commercial purposes. You may not reproduce, distribute, republish, scrape, or repurpose any content from this Site for commercial use without the express written permission of Pacific Northwest Analytics LLC.",
      "Brief quotations with attribution and a link to the original page are permitted for editorial and journalistic purposes.",
    ],
  },
  {
    heading: "7. Third-Party Content and Links",
    paragraphs: [
      "This Site may contain links to third-party websites, data sources, or resources. These links are provided for convenience only. Pacific Northwest Analytics LLC does not control, endorse, or assume responsibility for the content, accuracy, or practices of any third-party site.",
      "This Site displays third-party advertising served by independent ad networks. Advertisements are not endorsements of any product or service. Pacific Northwest Analytics LLC has no affiliation with advertisers and receives no referral fees or commissions tied to annuity sales.",
    ],
  },
  {
    heading: "8. Limitation of Liability",
    paragraphs: [
      "To the fullest extent permitted by applicable law, Pacific Northwest Analytics LLC, its members, officers, contributors, and agents shall not be liable for any direct, indirect, incidental, special, consequential, or punitive damages arising out of or related to your use of, or inability to use, this Site or its content.",
      "This limitation applies regardless of the theory of liability — whether in contract, tort, negligence, strict liability, or otherwise — and even if Pacific Northwest Analytics LLC has been advised of the possibility of such damages.",
    ],
  },
  {
    heading: "9. Disclaimer of Warranties",
    paragraphs: [
      "This Site is provided on an \"as is\" and \"as available\" basis without warranties of any kind, either express or implied, including but not limited to implied warranties of merchantability, fitness for a particular purpose, or non-infringement. Pacific Northwest Analytics LLC does not warrant that the Site will be uninterrupted, error-free, or free of viruses or other harmful components.",
    ],
  },
  {
    heading: "10. Governing Law",
    paragraphs: [
      "These Terms of Service are governed by and construed in accordance with the laws of the State of Washington, without regard to its conflict of law provisions. Any dispute arising under these terms shall be subject to the exclusive jurisdiction of the state and federal courts located in Washington State.",
    ],
  },
  {
    heading: "11. Changes to These Terms",
    paragraphs: [
      "Pacific Northwest Analytics LLC reserves the right to modify these Terms of Service at any time. Changes will be posted to this page with an updated effective date. Your continued use of the Site following any changes constitutes your acceptance of the revised terms.",
    ],
  },
];
---
<BaseLayout title={title} description={description}>
  <main
    style="max-width:768px;margin:0 auto;padding:48px 24px;color:rgb(1,8,22);font-family:'DM Sans',ui-sans-serif,system-ui,sans-serif;"
  >
    <p style="font-size:12px;font-weight:600;text-transform:uppercase;letter-spacing:0.1em;color:rgb(245,158,11);margin:0 0 12px 0;">Legal</p>

    <h1 style={`font-family:${SERIF};font-size:clamp(1.8rem, 4vw, 2.5rem);color:rgb(1,8,22);margin:0 0 12px 0;line-height:1.15;font-weight:400;`}>
      Terms of Service
    </h1>

    <p style="color:rgb(100,116,139);font-size:18px;line-height:1.625;margin:0 0 40px 0;">
      Effective date: April 2026
    </p>

    <p style={pStyle}>
      Please read these Terms of Service carefully before using RankMyAnnuity.pro (the "Site"). By accessing or using the Site, you agree to be bound by these terms. If you do not agree, do not use the Site.
    </p>

    {sections.map((section) => (
      <>
        <h2 style={h2Style}>{section.heading}</h2>
        {section.paragraphs.map((p) => {
          // Inline the methodology link inside section 4 paragraph 2
          if (p.startsWith('A high grade means')) {
            return (
              <p style={pStyle}>
                A high grade means an annuity's implied yield compares favorably to current benchmarks under the assumptions described in our <a href="/methodology" style={linkStyle}>Methodology</a>. It is not a statement that the product is suitable for any particular investor, that the carrier is financially sound, or that the product is free of risks, fees, or contractual limitations not captured in the calculation.
              </p>
            );
          }
          return <p style={pStyle}>{p}</p>;
        })}
      </>
    ))}

    <h2 style={h2Style}>12. Contact</h2>
    <p style={pStyle}>
      Questions about these Terms of Service may be directed to: <a href="mailto:rankmyannuity@gmail.com" style={linkStyle}>rankmyannuity@gmail.com</a>
    </p>

    <p style="color:rgb(148,163,184);font-size:14px;margin-top:32px;">
      Pacific Northwest Analytics LLC · State of Washington
    </p>
  </main>
</BaseLayout>
