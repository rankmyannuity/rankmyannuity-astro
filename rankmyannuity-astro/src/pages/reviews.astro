---
import BaseLayout from "../layouts/BaseLayout.astro";

const title = "Annuity Reviews — Carrier Overviews & Product Analysis | RankMyAnnuity";
const description =
  "Independent, no-commission reviews of products from the largest annuity carriers in the U.S. Every review is written by a licensed insurance professional with no affiliate relationships.";

const SERIF = "'DM Serif Display', Georgia, serif";

type Product = {
  grade: string;
  score: number;
  pct: number;
  name: string;
  angle: string;
  term: string;
};
type Carrier = {
  name: string;
  note: string;
  strength: string; // AM Best
  products: Product[];
};

const fia: Carrier[] = [
