function strengthBadgeStyle(s: string) {
  if (s.startsWith("A++") || s === "A+") return "color:rgb(5,150,105);background:rgba(5,150,105,0.1);border:1px solid rgba(5,150,105,0.2);";
  if (s === "A" || s === "A-") return "color:rgb(16,185,129);background:rgba(16,185,129,0.1);border:1px solid rgba(16,185,129,0.2);";
  return "color:rgb(100,116,139);background:rgba(241,245,249,0.5);border:1px solid rgb(226,232,240);";
}

function gradeColor(g: string) {
  if (g === "A" || g === "A+") return "rgb(5,150,105)";
  if (g === "B") return "rgb(16,185,129)";
  if (g === "C") return "rgb(100,116,139)";
  if (g === "D") return "rgb(245,158,11)";
  if (g === "F") return "rgb(220,38,38)";
  return "rgb(100,116,139)";
}

// Minimal HTML escape for any user-facing string interpolated into raw HTML.
function esc(s: string): string {
  return s
    .replace(/&/g, "&amp;")
    .replace(/</g, "&lt;")
    .replace(/>/g, "&gt;")
    .replace(/"/g, "&quot;")
    .replace(/'/g, "&#39;");
}

// Renders one carrier card. Product rows render as anchors when a slug exists
// (links to /reviews/<slug>) and as plain divs with a 'Coming soon' tag when
// they don't. The carrier name in the header links to the carrier review when
// the carrier itself has a slug.
function renderCarrierCard(c: Carrier): string {
  const carrierNameHtml = c.slug
    ? `<a href="/reviews/${esc(c.slug)}" style="color:inherit;text-decoration:none;" class="rma-carrier-link">${esc(c.name)}</a>`
    : esc(c.name);

  const productRowsHtml = c.products
    .map((p, idx) => {
      const tag = p.slug ? "a" : "div";
      const href = p.slug ? ` href="/reviews/${esc(p.slug)}"` : "";
      const rowClass = p.slug ? "rma-product-row rma-product-row--linked" : "rma-product-row";
      const cursor = p.slug ? "cursor:pointer;" : "";
      const borderTop = idx > 0 ? "border-top:1px solid rgb(226,232,240);" : "";
      // Trailing column shows the surrender term. Linked rows and unlinked rows
      // render identically; the link cue is the row’s hover state and chevron-free
      // anchor styling. This keeps the listing reading as a roster of grades rather
      // than as a placeholder catalog when only some products have full reviews.
      const trailing = `<span style="font-size:12px;color:rgb(100,116,139);flex-shrink:0;margin-left:12px;">${esc(p.term)}</span>`;

      return `
      <${tag}${href} style="display:flex;align-items:center;justify-content:space-between;padding:12px 20px;text-decoration:none;color:inherit;transition:background-color .15s;${cursor}${borderTop}" class="${rowClass}">
        <div style="display:flex;align-items:center;gap:12px;min-width:0;">
          <span style="flex-shrink:0;display:inline-flex;align-items:center;justify-content:center;width:32px;height:32px;border-radius:6px;background:${gradeColor(p.grade)};color:rgb(255,255,255);font-weight:700;font-size:13px;">${esc(p.grade)}</span>
          <div style="min-width:0;">
            <span style="font-size:14px;font-weight:500;color:rgb(1,8,22);">${esc(p.name)}</span>
            <span style="font-size:12px;color:rgb(100,116,139);margin-left:8px;">${esc(p.angle)}</span>
          </div>
        </div>
        ${trailing}
      </${tag}>`;
    })
    .join("");

  return `
    <article style="border:1px solid rgb(226,232,240);border-radius:12px;overflow:hidden;background:rgb(255,255,255);">
      <div style="background:rgba(241,245,249,0.3);padding:16px 20px;border-bottom:1px solid rgb(226,232,240);">
        <div style="display:flex;align-items:flex-start;justify-content:space-between;gap:12px;flex-wrap:wrap;">
          <div style="min-width:0;">
            <h3 style="font-family:${SERIF};font-size:18px;color:rgb(1,8,22);margin:0;font-weight:400;">${carrierNameHtml}</h3>
            <p style="font-size:12px;color:rgb(100,116,139);margin:4px 0 0 0;line-height:1.5;">${esc(c.note)}</p>
          </div>
          <div style="display:flex;flex-direction:column;align-items:flex-end;gap:2px;flex-shrink:0;">
            <span style="font-size:12px;font-weight:600;padding:4px 8px;border-radius:4px;${strengthBadgeStyle(c.strength)}">Carrier Strength: ${esc(c.strength)}</span>
            <span style="font-size:10px;color:rgb(100,116,139);">AM Best · Financial stability</span>
          </div>
        </div>
      </div>
      <div>${productRowsHtml}</div>
    </article>`;
}
---

<BaseLayout title={title} description={description}>
  <link
    slot="head"
    rel="preconnect"
    href="https://fonts.googleapis.com"
  />
  <link
    slot="head"
    rel="preconnect"
    href="https://fonts.gstatic.com"
    crossorigin
  />
  <link
    slot="head"
    rel="stylesheet"
    href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=DM+Serif+Display:ital@0;1&display=swap"
  />

  <main
    style="max-width:896px;margin:0 auto;padding:48px 24px;color:rgb(1,8,22);font-family:'DM Sans',ui-sans-serif,system-ui,sans-serif;"
  >
    <h1
      style={`font-family:${SERIF};font-size:clamp(1.8rem, 4vw, 2.5rem);color:rgb(1,8,22);margin:0 0 12px 0;line-height:1.15;`}
    >
      Annuity Product Reviews
    </h1>
    <p
      style="color:rgb(100,116,139);font-size:18px;line-height:1.625;margin:0 0 16px 0;max-width:42rem;"
    >
      Independent, no-commission reviews of products from the largest annuity
      carriers in the U.S. Every review is written by a licensed insurance
      professional with no affiliate relationships or sales incentives.
    </p>
    <p
      style="color:rgb(100,116,139);font-size:14px;line-height:1.625;margin:0 0 12px 0;max-width:42rem;"
    >
      Reviews are based on publicly available product data, state regulatory
      filings, and direct contract analysis. Product features vary by state and
      are subject to change. These reviews are for informational purposes only.
    </p>
    <div
      style="border-left:2px solid rgba(15,23,42,0.3);padding-left:12px;font-size:12px;color:rgb(100,116,139);max-width:42rem;margin-bottom:40px;line-height:1.65;"
    >
      <p style="margin:0 0 8px 0;">
        Each product shows a <strong style="color:rgba(1,8,22,0.8);font-weight:600;">letter grade</strong>
        based on its percentile rank within its own family (FIA, RILA, or VA), a
        <strong style="color:rgba(1,8,22,0.8);font-weight:600;">raw contract score</strong>
        (the underlying 0–100 numeric score), and
        <strong style="color:rgba(1,8,22,0.8);font-weight:600;">Carrier Strength</strong>
        (AM Best financial stability) in the carrier header.
      </p>
      <p style="margin:0;">
        Letter grades compare like-for-like within a product family — a VA with
        a raw score of 59 can earn a higher grade than an FIA with a raw score
        of 65 if it ranks better among VAs. Raw scores are comparable across
        all products.
        <a href="/methodology" style="color:rgb(15,23,42);text-decoration:underline;">
          Learn about our methodology →
        </a>
      </p>
    </div>

    {/* FIA SECTION */}
    <h2
      style={`font-family:${SERIF};font-size:24px;color:rgb(1,8,22);margin:32px 0 24px 0;`}
    >
      Fixed Indexed Annuity (FIA) Reviews
    </h2>
    <div style="display:flex;flex-direction:column;gap:32px;margin-bottom:64px;">
      {fia.map((c) => <Fragment set:html={renderCarrierCard(c)} />)}
    </div>

    {/* VA / RILA SECTION */}
    <h2
      style={`font-family:${SERIF};font-size:24px;color:rgb(1,8,22);margin:32px 0 24px 0;`}
    >
      Variable Annuity & RILA Reviews
    </h2>
    <div style="display:flex;flex-direction:column;gap:32px;margin-bottom:32px;">
      {va.map((c) => <Fragment set:html={renderCarrierCard(c)} />)}
    </div>
  </main>
</BaseLayout>

<style>
  /* Only linked rows show hover affordance; "Coming soon" rows stay flat. */
  .rma-product-row--linked:hover {
    background: rgba(241, 245, 249, 0.55);
  }
  .rma-carrier-link:hover {
    color: rgb(249, 112, 21) !important;
  }
</style>
