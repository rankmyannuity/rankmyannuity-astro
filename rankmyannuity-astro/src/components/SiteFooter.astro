---
// Phase 1 footer skeleton. Just the link scaffolding to every trust and
// legal page so crawlers see them from anywhere on the site. Copy and
// Organization/WebSite JSON-LD are deferred to the trust-page phase.
---
<footer class="border-t border-[var(--rule)] mt-12">
  <div class="mx-auto max-w-6xl px-4 py-8 grid gap-6 md:grid-cols-4 text-sm">
    <div>
      <p class="font-semibold">Tools</p>
      <ul class="mt-2 space-y-1">
        <li><a href="/calculator">Calculator</a></li>
        <li><a href="/rates">Rates</a></li>
        <li><a href="/glossary">Glossary</a></li>
      </ul>
    </div>
    <div>
      <p class="font-semibold">Content</p>
      <ul class="mt-2 space-y-1">
        <li><a href="/reviews">Reviews</a></li>
        <li><a href="/learn">Learn</a></li>
        <li><a href="/editor">Editor</a></li>
      </ul>
    </div>
    <div>
      <p class="font-semibold">Trust</p>
      <ul class="mt-2 space-y-1">
        <li><a href="/about">About</a></li>
        <li><a href="/methodology">Methodology</a></li>
        <li><a href="/editorial-policy">Editorial policy</a></li>
        <li><a href="/disclaimer">Disclaimer</a></li>
      </ul>
    </div>
    <div>
      <p class="font-semibold">Legal</p>
      <ul class="mt-2 space-y-1">
        <li><a href="/privacy">Privacy</a></li>
        <li><a href="/terms">Terms</a></li>
        <li><a href="/contact">Contact</a></li>
      </ul>
    </div>
  </div>
</footer>
