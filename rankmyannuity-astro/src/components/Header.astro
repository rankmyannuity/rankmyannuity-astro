---
// Sticky site header — used inside BaseLayout.astro.
// All styling is inline so it renders correctly with or without Tailwind tokens.
const { pathname } = Astro.url;
const navItems = [
  { href: "/calculator", label: "Calculator" },
  { href: "/rates", label: "Rates" },
  { href: "/reviews", label: "Reviews" },
  { href: "/learn", label: "Learn" },
  { href: "/methodology", label: "Methodology" },
  { href: "/about", label: "About" },
];
const isActive = (href: string) =>
  pathname === href || pathname.startsWith(href + "/");
---

<header
  style="position:sticky;top:0;z-index:40;background:rgba(255,255,255,0.9);backdrop-filter:blur(8px);-webkit-backdrop-filter:blur(8px);border-bottom:1px solid rgb(226,232,240);font-family:'DM Sans', ui-sans-serif, system-ui, sans-serif;"
>
  <div
    class="rma-header-inner"
    style="max-width:1024px;margin:0 auto;padding:0 24px;height:64px;display:flex;align-items:center;justify-content:space-between;gap:24px;"
  >
    <a
      href="/"
      style="display:inline-flex;align-items:center;gap:8px;text-decoration:none;color:rgb(1,8,22);flex-shrink:0;"
    >
      <span
        style="font-family:'DM Serif Display', Georgia, serif;font-size:20px;font-weight:400;letter-spacing:-0.025em;color:rgb(1,8,22);"
      >
        RankMyAnnuity.pro
      </span>
    </a>

    <nav
      class="rma-header-nav"
      style="display:flex;align-items:center;gap:2px;flex:1;justify-content:flex-end;"
    >
      {
        navItems.map((item) => (
          <a
            href={item.href}
            style={`padding:8px 12px;border-radius:6px;font-size:14px;font-weight:500;text-decoration:none;white-space:nowrap;transition:background-color .15s, color .15s;${
              isActive(item.href)
                ? "background:rgb(241,245,249);color:rgb(1,8,22);"
                : "background:transparent;color:rgb(100,116,139);"
            }`}
          >
            {item.label}
          </a>
        ))
      }

      <a
        href="/calculator"
        class="rma-header-cta"
        style="margin-left:12px;padding:8px 16px;border-radius:6px;font-size:14px;font-weight:500;text-decoration:none;white-space:nowrap;background:rgb(15,23,42);color:rgb(248,250,252);transition:background-color .15s;"
      >
        Grade Your Annuity
      </a>
    </nav>
  </div>
</header>

<style>
  /* Hover effects for nav links */
  header nav a:not(.rma-header-cta):hover {
    background: rgb(241, 245, 249);
    color: rgb(1, 8, 22);
  }
  header nav a.rma-header-cta:hover {
    background: rgb(30, 41, 59);
  }

  /* Tablet (<= 1024px): hide CTA to save space */
  @media (max-width: 1023px) {
    header .rma-header-cta {
      display: none !important;
    }
  }

  /* Mobile (<= 767px): hide entire nav, keep logo */
  @media (max-width: 767px) {
    header .rma-header-nav {
      display: none !important;
    }
  }
</style>
