---
// Site footer — 4-column layout (Tools / Content / Trust / Legal).
// All styling is inline so it renders correctly with or without Tailwind tokens.
const year = new Date().getFullYear();

const columns = [
  {
    heading: "Tools",
    links: [
      { href: "/calculator", label: "Calculator" },
      { href: "/rates", label: "Rates" },
      { href: "/glossary", label: "Glossary" },
    ],
  },
  {
    heading: "Content",
    links: [
      // { href: "/reviews", label: "Reviews" },  // Hidden — reviews pulled off production pending editorial work
      { href: "/learn", label: "Learn" },
    ],
  },
  {
    heading: "Trust",
    links: [
      { href: "/about", label: "About" },
      { href: "/methodology", label: "Methodology" },
    ],
  },
  {
    heading: "Legal",
    links: [
      { href: "/privacy", label: "Privacy" },
      { href: "/terms", label: "Terms" },
      { href: "/contact", label: "Contact" },
    ],
  },
];
---

<footer
  style="border-top:1px solid rgb(226,232,240);background:rgb(255,255,255);font-family:'DM Sans', ui-sans-serif, system-ui, sans-serif;margin-top:64px;"
>
  <div
    style="max-width:1024px;margin:0 auto;padding:48px 24px 32px 24px;"
  >
    <!-- Top: brand + columns -->
    <div
      class="rma-footer-grid"
      style="display:grid;grid-template-columns:1.4fr repeat(4, 1fr);gap:40px;"
    >
      <!-- Brand -->
      <div>
        <a
          href="/"
          style="display:inline-block;text-decoration:none;color:rgb(1,8,22);"
        >
          <span
            style="font-family:'DM Serif Display', Georgia, serif;font-size:20px;font-weight:400;letter-spacing:-0.025em;color:rgb(1,8,22);"
          >
            RankMyAnnuity.pro
          </span>
        </a>
        <p
          style="margin:12px 0 0 0;font-size:13px;line-height:1.6;color:rgb(100,116,139);max-width:280px;"
        >
          Independent annuity grading and rate data built for shoppers and
          advisors.
        </p>
      </div>

      <!-- Link columns -->
      {
        columns.map((col) => (
          <div>
            <div
              style="font-size:12px;font-weight:600;text-transform:uppercase;letter-spacing:0.08em;color:rgb(1,8,22);margin-bottom:16px;"
            >
              {col.heading}
            </div>
            <ul style="list-style:none;padding:0;margin:0;display:flex;flex-direction:column;gap:10px;">
              {col.links.map((link) => (
                <li>
                  <a
                    href={link.href}
                    style="font-size:14px;color:rgb(100,116,139);text-decoration:none;transition:color .15s;"
                  >
                    {link.label}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>

    <!-- Bottom: copyright + disclaimer -->
    <div
      style="margin-top:40px;padding-top:24px;border-top:1px solid rgb(226,232,240);display:flex;flex-wrap:wrap;gap:12px;align-items:center;justify-content:space-between;"
    >
      <p style="margin:0;font-size:12px;color:rgb(100,116,139);">
        © {year} RankMyAnnuity.pro. All rights reserved.
      </p>
      <p style="margin:0;font-size:12px;color:rgb(100,116,139);max-width:560px;text-align:right;">
        Educational content only. Not investment, tax, or legal advice. Annuity
        guarantees rely on the claims-paying ability of the issuing insurer.
      </p>
    </div>
  </div>
</footer>

<style>
  /* Hover for footer links */
  footer a:hover {
    color: rgb(1, 8, 22) !important;
  }

  /* Tablet (<= 900px): collapse brand to row, columns become 2x2 */
  @media (max-width: 900px) {
    footer .rma-footer-grid {
      grid-template-columns: repeat(2, 1fr) !important;
      gap: 32px !important;
    }
    footer .rma-footer-grid > div:first-child {
      grid-column: 1 / -1;
    }
  }

  /* Mobile (<= 540px): single column, left-align bottom text */
  @media (max-width: 540px) {
    footer .rma-footer-grid {
      grid-template-columns: 1fr !important;
      gap: 28px !important;
    }
    footer > div > div:last-child {
      flex-direction: column;
      align-items: flex-start !important;
    }
    footer > div > div:last-child p:last-child {
      text-align: left !important;
    }
  }
</style>
