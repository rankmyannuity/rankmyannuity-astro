---
// ArticleLayout — used by /learn/[slug].
//
// Visual styling matches the rest of the migrated site (Learn index, glossary,
// calculator, etc.): inline rgb() values, DM Serif Display for headings, DM
// Sans for body, with a global stylesheet block that targets every MDX-emitted
// element inside [data-article-body]. We can't rely on the Tailwind Typography
// plugin (`prose`) — it isn't installed.
import BaseLayout from "./BaseLayout.astro";

export interface Person {
  name: string;
  title?: string;
  url?: string;
  bio?: string;
}
export interface Source {
  label: string;
  url: string;
  publisher?: string;
  accessed?: Date;
}
export interface RelatedItem {
  slug: string;
  title: string;
  kind: "learn" | "reviews";
}

export interface Props {
  title: string;
  description: string;
  publishedAt: Date;
  updatedAt: Date;
  author: Person;
  reviewer?: Person;
  tags?: string[];
  sources?: Source[];
  related?: RelatedItem[];
  disclaimer?: "general" | "yield" | "ranking" | "product" | "carrier";
  canonicalPath?: string;
  breadcrumbLabel?: string;
}

const {
  title,
  description,
  publishedAt,
  updatedAt,
  author,
  reviewer,
  tags = [],
  sources = [],
  related = [],
  disclaimer = "general",
  canonicalPath,
  breadcrumbLabel,
} = Astro.props;

const fmt = (d: Date) =>
  d.toLocaleDateString("en-US", { year: "numeric", month: "long", day: "numeric" });

const disclaimerCopy: Record<string, string> = {
  general: "Educational content — not personalized advice.",
  yield: "Rate snapshots can change; see methodology.",
  ranking: "Rankings derived from documented IRR methodology.",
  product: "Features summarized from issuer materials at the time of writing.",
  carrier: "Financial-strength ratings change; see methodology.",
};

const crumbLabel = breadcrumbLabel ?? title;
---

<BaseLayout title={title} description={description}>
  <article
    style="max-width:760px;margin:0 auto;padding:32px 24px 64px 24px;font-family:'DM Sans', ui-sans-serif, system-ui, sans-serif;color:rgb(1,8,22);"
  >
    <!-- Breadcrumbs -->
    <nav
      aria-label="Breadcrumb"
      style="font-size:12px;color:rgb(100,116,139);margin:0 0 24px 0;"
    >
      <ol style="display:flex;flex-wrap:wrap;gap:6px;list-style:none;padding:0;margin:0;">
        <li style="display:flex;align-items:center;gap:6px;">
          <a
            href="/"
            style="color:rgb(100,116,139);text-decoration:none;"
            class="rma-crumb"
          >Home</a>
          <span aria-hidden="true" style="color:rgb(203,213,225);">/</span>
        </li>
        <li style="display:flex;align-items:center;gap:6px;">
          <a
            href="/learn"
            style="color:rgb(100,116,139);text-decoration:none;"
            class="rma-crumb"
          >Learn</a>
          <span aria-hidden="true" style="color:rgb(203,213,225);">/</span>
        </li>
        <li>
          <span aria-current="page" style="color:rgb(1,8,22);">{crumbLabel}</span>
        </li>
      </ol>
    </nav>

    <!-- Eyebrow -->
    <p
      style="margin:0 0 12px 0;font-size:12px;font-weight:600;text-transform:uppercase;letter-spacing:0.1em;color:rgb(249,112,21);"
    >
      Learn
    </p>

    <!-- H1 -->
    <h1
      style="font-family:'DM Serif Display', Georgia, serif;font-weight:400;font-size:44px;line-height:1.15;letter-spacing:-0.02em;margin:0 0 20px 0;color:rgb(1,8,22);"
    >
      {title}
    </h1>

    <!-- Description / dek -->
    <p
      style="font-size:19px;line-height:1.55;color:rgb(51,65,85);margin:0 0 24px 0;"
    >
      {description}
    </p>

    <!-- Author block -->
    <div
      data-author-block
      style="font-size:13px;color:rgb(100,116,139);margin:0 0 16px 0;line-height:1.6;"
    >
      <p style="margin:0;">
        By {author.url ? <a href={author.url} class="rma-meta-link" style="color:rgb(100,116,139);text-decoration:underline;text-underline-offset:2px;">{author.name}</a> : author.name}
        {author.title && <span>· {author.title}</span>}
        {reviewer && (
          <>
            <span> · </span>
            Reviewed by {reviewer.url ? <a href={reviewer.url} class="rma-meta-link" style="color:rgb(100,116,139);text-decoration:underline;text-underline-offset:2px;">{reviewer.name}</a> : reviewer.name}
            {reviewer.title && <span> · {reviewer.title}</span>}
          </>
        )}
      </p>
      <p style="margin:4px 0 0 0;">
        Published <time datetime={publishedAt.toISOString()}>{fmt(publishedAt)}</time>
        <span> · </span>
        Updated <time datetime={updatedAt.toISOString()}>{fmt(updatedAt)}</time>
      </p>
    </div>

    <!-- Tags -->
    {tags.length > 0 && (
      <ul
        style="display:flex;flex-wrap:wrap;gap:6px;list-style:none;padding:0;margin:0 0 24px 0;font-size:12px;"
      >
        {tags.map((t) => (
          <li
            style="border:1px solid rgb(226,232,240);border-radius:9999px;padding:3px 10px;color:rgb(71,85,105);background:rgb(248,250,252);"
          >
            {t}
          </li>
        ))}
      </ul>
    )}

    <!-- Disclaimer -->
    <aside
      role="note"
      data-disclaimer={disclaimer}
      style="margin:0 0 32px 0;padding:12px 16px;border-left:3px solid rgb(249,112,21);background:rgb(255,247,237);font-size:13px;color:rgb(71,85,105);line-height:1.5;border-radius:0 6px 6px 0;"
    >
      <strong style="color:rgb(1,8,22);">Disclosure.</strong> {disclaimerCopy[disclaimer]}
    </aside>

    <!-- Article body (MDX) -->
    <div data-article-body>
      <slot />
    </div>

    <!-- Sources -->
    {sources.length > 0 && (
      <section
        aria-labelledby="sources-heading"
        style="margin:48px 0 0 0;padding:24px 0 0 0;border-top:1px solid rgb(226,232,240);font-size:14px;"
      >
        <h2
          id="sources-heading"
          style="font-family:'DM Serif Display', Georgia, serif;font-weight:400;font-size:22px;line-height:1.3;margin:0 0 12px 0;color:rgb(1,8,22);letter-spacing:-0.01em;"
        >
          Sources
        </h2>
        <ol style="margin:0;padding:0 0 0 20px;color:rgb(71,85,105);line-height:1.7;">
          {sources.map((s) => (
            <li style="margin:0 0 6px 0;">
              <a
                href={s.url}
                rel="nofollow noopener"
                style="color:rgb(15,23,42);text-decoration:underline;text-underline-offset:2px;"
                class="rma-source-link"
              >{s.label}</a>
              {s.publisher && <span> — {s.publisher}</span>}
              {s.accessed && (
                <span> (accessed {s.accessed.toLocaleDateString("en-US")})</span>
              )}
            </li>
          ))}
        </ol>
      </section>
    )}

    <!-- Related -->
    {related.length > 0 && (
      <section
        aria-labelledby="related-heading"
        style="margin:48px 0 0 0;padding:24px 0 0 0;border-top:1px solid rgb(226,232,240);"
      >
        <h2
          id="related-heading"
          style="font-family:'DM Serif Display', Georgia, serif;font-weight:400;font-size:22px;line-height:1.3;margin:0 0 16px 0;color:rgb(1,8,22);letter-spacing:-0.01em;"
        >
          Related reading
        </h2>
        <ul
          class="rma-related-grid"
          style="list-style:none;padding:0;margin:0;display:grid;grid-template-columns:1fr 1fr;gap:12px;"
        >
          {related.map((i) => (
            <li>
              <a
                href={`/${i.kind}/${i.slug}`}
                style="display:block;padding:14px 16px;border:1px solid rgb(226,232,240);border-radius:8px;color:rgb(1,8,22);text-decoration:none;font-size:14px;line-height:1.4;background:rgb(255,255,255);transition:border-color .15s,transform .15s;"
                class="rma-related-card"
              >{i.title}</a>
            </li>
          ))}
        </ul>
      </section>
    )}

    <!-- Bottom CTA -->
    <section
      style="margin:48px 0 0 0;padding:32px 24px;background:rgb(248,250,252);border:1px solid rgb(226,232,240);border-radius:10px;text-align:center;"
    >
      <h2
        style="font-family:'DM Serif Display', Georgia, serif;font-weight:400;font-size:24px;line-height:1.2;letter-spacing:-0.01em;margin:0 0 8px 0;color:rgb(1,8,22);"
      >
        Ready to grade an annuity offer?
      </h2>
      <p style="margin:0 0 18px 0;font-size:14px;color:rgb(100,116,139);">
        Free, no account, IRR-based grade in under a minute.
      </p>
      <a
        href="/calculator"
        style="display:inline-block;padding:11px 22px;border-radius:8px;font-size:14px;font-weight:500;text-decoration:none;background:rgb(15,23,42);color:rgb(248,250,252);transition:background-color .15s;"
        class="rma-cta-primary"
      >Grade My Annuity</a>
    </section>
  </article>
</BaseLayout>

<style is:global>
  /* ============================================================
     Article body — styles every element MDX emits inside
     [data-article-body] without depending on the Tailwind
     Typography plugin (which isn't installed).
     ============================================================ */

  [data-article-body] {
    font-family: "DM Sans", ui-sans-serif, system-ui, -apple-system,
      "Segoe UI", Roboto, sans-serif;
    font-size: 17px;
    line-height: 1.7;
    color: rgb(30, 41, 59);
  }

  [data-article-body] > *:first-child {
    margin-top: 0;
  }
  [data-article-body] > *:last-child {
    margin-bottom: 0;
  }

  /* Headings */
  [data-article-body] h2 {
    font-family: "DM Serif Display", Georgia, serif;
    font-weight: 400;
    font-size: 30px;
    line-height: 1.2;
    letter-spacing: -0.015em;
    color: rgb(1, 8, 22);
    margin: 40px 0 16px 0;
  }
  [data-article-body] h3 {
    font-family: "DM Serif Display", Georgia, serif;
    font-weight: 400;
    font-size: 22px;
    line-height: 1.25;
    letter-spacing: -0.01em;
    color: rgb(1, 8, 22);
    margin: 32px 0 12px 0;
  }
  [data-article-body] h4 {
    font-family: "DM Sans", ui-sans-serif, system-ui, sans-serif;
    font-weight: 600;
    font-size: 17px;
    line-height: 1.3;
    color: rgb(1, 8, 22);
    margin: 24px 0 8px 0;
  }

  /* Paragraphs */
  [data-article-body] p {
    margin: 0 0 18px 0;
    color: rgb(30, 41, 59);
  }

  /* Inline emphasis */
  [data-article-body] strong {
    font-weight: 600;
    color: rgb(1, 8, 22);
  }
  [data-article-body] em {
    font-style: italic;
  }

  /* Links inside the article body */
  [data-article-body] a {
    color: rgb(15, 23, 42);
    text-decoration: underline;
    text-underline-offset: 3px;
    text-decoration-thickness: 1px;
    transition: color 0.15s;
  }
  [data-article-body] a:hover {
    color: rgb(249, 112, 21);
  }

  /* Lists */
  [data-article-body] ul,
  [data-article-body] ol {
    margin: 0 0 20px 0;
    padding-left: 26px;
    color: rgb(30, 41, 59);
  }
  [data-article-body] ul {
    list-style: disc;
  }
  [data-article-body] ol {
    list-style: decimal;
  }
  [data-article-body] li {
    margin: 0 0 8px 0;
    line-height: 1.65;
  }
  [data-article-body] li > ul,
  [data-article-body] li > ol {
    margin-top: 8px;
    margin-bottom: 8px;
  }

  /* Blockquote */
  [data-article-body] blockquote {
    margin: 24px 0;
    padding: 4px 0 4px 20px;
    border-left: 3px solid rgb(226, 232, 240);
    color: rgb(71, 85, 105);
    font-style: italic;
  }
  [data-article-body] blockquote p {
    margin: 0 0 8px 0;
  }
  [data-article-body] blockquote p:last-child {
    margin-bottom: 0;
  }

  /* Inline code */
  [data-article-body] code {
    font-family: ui-monospace, SFMono-Regular, "SF Mono", Menlo, Consolas, monospace;
    font-size: 0.92em;
    background: rgb(241, 245, 249);
    color: rgb(15, 23, 42);
    padding: 2px 6px;
    border-radius: 4px;
  }
  [data-article-body] pre {
    background: rgb(15, 23, 42);
    color: rgb(241, 245, 249);
    padding: 16px 18px;
    border-radius: 8px;
    overflow-x: auto;
    margin: 0 0 20px 0;
    font-size: 14px;
    line-height: 1.55;
  }
  [data-article-body] pre code {
    background: transparent;
    color: inherit;
    padding: 0;
    font-size: inherit;
  }

  /* Horizontal rule */
  [data-article-body] hr {
    border: 0;
    border-top: 1px solid rgb(226, 232, 240);
    margin: 32px 0;
  }

  /* Tables */
  [data-article-body] table {
    width: 100%;
    border-collapse: collapse;
    margin: 24px 0;
    font-size: 15px;
    line-height: 1.5;
    border: 1px solid rgb(226, 232, 240);
    border-radius: 8px;
    overflow: hidden;
  }
  [data-article-body] thead {
    background: rgb(248, 250, 252);
  }
  [data-article-body] th {
    text-align: left;
    font-weight: 600;
    color: rgb(1, 8, 22);
    padding: 10px 14px;
    border-bottom: 1px solid rgb(226, 232, 240);
    font-family: "DM Sans", ui-sans-serif, system-ui, sans-serif;
  }
  [data-article-body] td {
    padding: 10px 14px;
    border-top: 1px solid rgb(241, 245, 249);
    color: rgb(30, 41, 59);
    vertical-align: top;
  }
  [data-article-body] tbody tr:nth-child(even) {
    background: rgb(252, 253, 254);
  }

  /* Images */
  [data-article-body] img {
    max-width: 100%;
    height: auto;
    border-radius: 8px;
    margin: 16px 0;
  }
  [data-article-body] figure {
    margin: 24px 0;
  }
  [data-article-body] figcaption {
    font-size: 13px;
    color: rgb(100, 116, 139);
    margin-top: 6px;
    text-align: center;
  }

  /* ============================================================
     Hover effects for sidecar UI
     ============================================================ */

  .rma-crumb:hover {
    color: rgb(249, 112, 21) !important;
  }
  .rma-meta-link:hover {
    color: rgb(249, 112, 21) !important;
  }
  .rma-source-link:hover {
    color: rgb(249, 112, 21) !important;
  }
  .rma-related-card:hover {
    border-color: rgb(15, 23, 42) !important;
    transform: translateY(-1px);
  }
  .rma-cta-primary:hover {
    background: rgb(30, 41, 59) !important;
  }

  /* ============================================================
     Responsive
     ============================================================ */
  @media (max-width: 720px) {
    article[style*="max-width:760px"] {
      padding: 24px 18px 48px 18px !important;
    }
    article[style*="max-width:760px"] h1 {
      font-size: 34px !important;
    }
    [data-article-body] {
      font-size: 16px;
    }
    [data-article-body] h2 {
      font-size: 24px !important;
      margin-top: 32px !important;
    }
    [data-article-body] h3 {
      font-size: 19px !important;
    }
    .rma-related-grid {
      grid-template-columns: 1fr !important;
    }
    [data-article-body] table {
      font-size: 14px;
    }
    [data-article-body] th,
    [data-article-body] td {
      padding: 8px 10px;
    }
  }
</style>
