---
// ArticleLayout — used by /learn/[slug]. Includes every required trust
// scaffold element: breadcrumbs, H1, author block, disclaimer slot, related
// links area, sources. Authors never edit this file.
import BaseLayout from './BaseLayout.astro';
import Breadcrumbs from '@components/Breadcrumbs.astro';
import AuthorBlock from '@components/AuthorBlock.astro';
import DisclaimerSlot from '@components/DisclaimerSlot.astro';
import RelatedLinks from '@components/RelatedLinks.astro';
import SourceList from '@components/SourceList.astro';

export interface Person { name: string; title?: string; url?: string; }
export interface Source { label: string; url: string; publisher?: string; accessed?: Date; }
export interface RelatedItem { slug: string; title: string; kind: 'learn' | 'reviews'; }

export interface Props {
  title: string;
  description: string;
  publishedAt: Date;
  updatedAt: Date;
  author: Person;
  reviewer?: Person;
  tags?: string[];
  sources?: Source[];
  related?: RelatedItem[];
  disclaimer?: 'general' | 'yield' | 'ranking' | 'product';
  canonicalPath?: string;
  /** Used for the final breadcrumb crumb if different from <title> */
  breadcrumbLabel?: string;
}

const {
  title,
  description,
  publishedAt,
  updatedAt,
  author,
  reviewer,
  tags = [],
  sources = [],
  related = [],
  disclaimer = 'general',
  canonicalPath,
  breadcrumbLabel,
} = Astro.props;

const crumbs = [
  { label: 'Home', href: '/' },
  { label: 'Learn', href: '/learn' },
  { label: breadcrumbLabel ?? title },
];
---
<BaseLayout title={title} description={description} canonicalPath={canonicalPath}>
  <article class="mx-auto max-w-3xl px-4 py-10">
    <Breadcrumbs items={crumbs} />

    <header class="mt-4 mb-6">
      <h1 class="text-3xl font-semibold tracking-tight">{title}</h1>
      <p class="mt-3 text-[var(--muted)]">{description}</p>
      <AuthorBlock
        author={author}
        reviewer={reviewer}
        publishedAt={publishedAt}
        updatedAt={updatedAt}
      />
      {tags.length > 0 && (
        <ul class="mt-3 flex flex-wrap gap-2 text-xs">
          {tags.map((t) => <li class="rounded border border-[var(--rule)] px-2 py-0.5">{t}</li>)}
        </ul>
      )}
    </header>

    <DisclaimerSlot variant={disclaimer} />

    <div data-article-body class="prose">
      <slot />
    </div>

    <SourceList sources={sources} />
    <RelatedLinks items={related} />
  </article>
</BaseLayout>
