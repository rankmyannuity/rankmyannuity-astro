---
// ReviewLayout — used by /reviews/[slug] for both carrier and product reviews.
// Includes breadcrumbs, H1, author block, optional grade verdict, key-facts
// strip, disclaimer, body slot, related links, sources.
import BaseLayout from './BaseLayout.astro';
import Breadcrumbs from '@components/Breadcrumbs.astro';
import AuthorBlock from '@components/AuthorBlock.astro';
import DisclaimerSlot from '@components/DisclaimerSlot.astro';
import RelatedLinks from '@components/RelatedLinks.astro';
import SourceList from '@components/SourceList.astro';

export interface Person { name: string; title?: string; url?: string; }
export interface Source { label: string; url: string; publisher?: string; accessed?: Date; }
export interface RelatedItem { slug: string; title: string; kind: 'learn' | 'reviews'; }

export interface Props {
  kind: 'carrier' | 'product';
  title: string;
  description: string;
  publishedAt: Date;
  updatedAt: Date;
  author: Person;
  reviewer?: Person;
  tags?: string[];
  sources?: Source[];
  related?: RelatedItem[];
  canonicalPath?: string;
  breadcrumbLabel?: string;

  /** Generic key-facts strip, e.g. {"A.M. Best": "A+", "Domicile": "IA"} */
  facts?: Record<string, string | number | undefined>;

  /** Editorial verdict shown prominently above the body */
  verdict?: {
    grade?: string;
    gradeStatus?: 'active' | 'deferred' | 'retired';
    bestFor?: string;
    watchouts?: string[];
  };

  /** [Phase 5] Pass through to BaseLayout — set to true for not-live reviews
   *  (pilot / degraded / empty benchmark / retired) so crawlers skip the page.
   *  See src/lib/ui/liveness.ts for the canonical rule set. */
  noindex?: boolean;
}

const {
  kind,
  title,
  description,
  publishedAt,
  updatedAt,
  author,
  reviewer,
  tags = [],
  sources = [],
  related = [],
  canonicalPath,
  breadcrumbLabel,
  facts = {},
  verdict = {},
  noindex = false,
} = Astro.props;

const crumbs = [
  { label: 'Home', href: '/' },
  { label: 'Reviews', href: '/reviews' },
  { label: breadcrumbLabel ?? title },
];

const factEntries = Object.entries(facts).filter(([, v]) => v !== undefined && v !== '');
const gradeVisible = !!verdict.grade && verdict.gradeStatus === 'active';
const hasVerdict = gradeVisible || !!verdict.bestFor || (verdict.watchouts?.length ?? 0) > 0;
---
<BaseLayout title={title} description={description} canonicalPath={canonicalPath} noindex={noindex}>
  <article class="mx-auto max-w-3xl px-4 py-10">
    <Breadcrumbs items={crumbs} />

    <header class="mt-4 mb-6">
      <p class="text-xs uppercase tracking-wide text-[var(--muted)]">
        {kind === 'carrier' ? 'Carrier review' : 'Product review'}
      </p>
      <h1 class="mt-1 text-3xl font-semibold tracking-tight">{title}</h1>
      <p class="mt-3 text-[var(--muted)]">{description}</p>
      <AuthorBlock
        author={author}
        reviewer={reviewer}
        publishedAt={publishedAt}
        updatedAt={updatedAt}
      />
      {tags.length > 0 && (
        <ul class="mt-3 flex flex-wrap gap-2 text-xs">
          {tags.map((t) => <li class="rounded border border-[var(--rule)] px-2 py-0.5">{t}</li>)}
        </ul>
      )}
    </header>

    {factEntries.length > 0 && (
      <section
        aria-label="Key facts"
        class="rounded border border-[var(--rule)] p-4 my-6 grid gap-3 text-sm md:grid-cols-4"
      >
        {factEntries.map(([k, v]) => (
          <div>
            <div class="text-[var(--muted)]">{k}</div>
            <div>{v}</div>
          </div>
        ))}
      </section>
    )}

    {hasVerdict && (
      <section
        aria-label="Editorial verdict"
        class="rounded border border-[var(--rule)] p-4 my-4 text-sm"
      >
        {verdict.grade && verdict.gradeStatus === 'active' && (
        <p><strong>Grade:</strong> <span class="font-semibold">{verdict.grade}</span></p>
        )}}
        {verdict.bestFor && (
          <p class="mt-1"><strong>Best for:</strong> {verdict.bestFor}</p>
        )}
        {verdict.watchouts && verdict.watchouts.length > 0 && (
          <div class="mt-1">
            <strong>Watch-outs:</strong>
            <ul class="list-disc pl-5 mt-1">
              {verdict.watchouts.map((w) => <li>{w}</li>)}
            </ul>
          </div>
        )}
      </section>
    )}

    <DisclaimerSlot variant={kind === 'carrier' ? 'carrier' : 'product'} />

    <div data-review-body class="prose">
      <slot />
    </div>

    <SourceList sources={sources} />
    <RelatedLinks items={related} />
  </article>
</BaseLayout>
