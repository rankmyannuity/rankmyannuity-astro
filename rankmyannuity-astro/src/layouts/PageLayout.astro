---
// PageLayout — backs the `pages` collection (/about, /methodology, etc.).
// Simpler than ArticleLayout: no tags, no related links by default, no
// review verdict. Still renders canonical, H1, dates, author, and a
// disclaimer slot.
import BaseLayout from './BaseLayout.astro';
import Breadcrumbs from '@components/Breadcrumbs.astro';
import AuthorBlock from '@components/AuthorBlock.astro';
import DisclaimerSlot from '@components/DisclaimerSlot.astro';

export interface Person { name: string; title?: string; url?: string; }

export interface Props {
  title: string;
  description: string;
  publishedAt: Date;
  updatedAt: Date;
  author: Person;
  canonicalPath?: string;
  canonicalOverride?: string;
  noindex?: boolean;
  breadcrumbLabel?: string;
  showDisclaimer?: boolean;
}

const {
  title,
  description,
  publishedAt,
  updatedAt,
  author,
  canonicalPath,
  canonicalOverride,
  noindex = false,
  breadcrumbLabel,
  showDisclaimer = false,
} = Astro.props;

const crumbs = [
  { label: 'Home', href: '/' },
  { label: breadcrumbLabel ?? title },
];
---
<BaseLayout
  title={title}
  description={description}
  canonicalPath={canonicalPath}
  canonicalOverride={canonicalOverride}
  noindex={noindex}
>
  <article class="mx-auto max-w-3xl px-4 py-10">
    <Breadcrumbs items={crumbs} />
    <header class="mt-4 mb-6">
      <h1 class="text-3xl font-semibold tracking-tight">{title}</h1>
      <p class="mt-3 text-[var(--muted)]">{description}</p>
      <AuthorBlock author={author} publishedAt={publishedAt} updatedAt={updatedAt} />
    </header>
    {showDisclaimer && <DisclaimerSlot variant="general" />}
    <div data-page-body class="prose">
      <slot />
    </div>
  </article>
</BaseLayout>
