---
// ToolLayout — used by interactive tool pages: /calculator (and /rates,
// which is calculator-adjacent). It establishes the rule that every tool
// page ships real HTML (title, H1, intro copy, noscript fallback) so the
// crawler sees the page even if the island never hydrates.
//
// The React island itself is mounted by the page via <slot name="tool" />.
// That way this layout stays agnostic to which tool it's wrapping.

import BaseLayout from './BaseLayout.astro';

export interface Props {
  title: string;
  description: string;
  intro: string;           // plain-text intro paragraph, always server-rendered
  canonicalPath?: string;
  noscriptText?: string;   // shown when JS is disabled or island hasn't loaded
}

const { title, description, intro, canonicalPath, noscriptText } = Astro.props;
---
<BaseLayout title={title} description={description} canonicalPath={canonicalPath}>
  <section class="mx-auto max-w-4xl px-4 py-10">
    <h1 class="text-3xl font-semibold">{title}</h1>
    <p class="mt-3 text-[var(--muted)]">{intro}</p>

    <div class="my-8">
      <slot name="tool" />
      {noscriptText && (
        <noscript>
          <p class="mt-4 text-sm text-[var(--muted)]">{noscriptText}</p>
        </noscript>
      )}
    </div>

    <slot name="explainer" />
  </section>
</BaseLayout>
